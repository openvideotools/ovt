diff --git a/tests/fate/hevc.mak b/tests/fate/hevc.mak
index 7f7ec43..009b57d 100644
--- a/tests/fate/hevc.mak
+++ b/tests/fate/hevc.mak
@@ -291,6 +291,20 @@ FATE_HEVC-$(call FRAMECRC, HEVC, HEVC, CONCAT_PROTOCOL) += fate-hevc-mv-switch
 fate-hevc-mv-position: CMD = framecrc -i $(TARGET_SAMPLES)/hevc/multiview.mov -map 0:v:vpos:left -map 0:v:vpos:right
