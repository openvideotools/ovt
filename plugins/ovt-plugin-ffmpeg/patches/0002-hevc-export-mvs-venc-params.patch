diff --git a/libavutil/video_enc_params.h b/libavutil/video_enc_params.h
index 62265a5..b17fd97 100644
--- a/libavutil/video_enc_params.h
+++ b/libavutil/video_enc_params.h
@@ -63,6 +63,21 @@ enum AVVideoEncParamsType {
      * resulting quantizer for the block.
      */
     AV_VIDEO_ENC_PARAMS_MPEG2,
+
+    /**
+     * H.265 stores:
+     * - in PPS (per-picture):
+     *   * initial QP_Y (luma) value (26 + init_qp_minus26), exported as
+     *     AVVideoEncParams.qp
+     *   * pps_cb_qp_offset and pps_cr_qp_offset, exported as
+     *     AVVideoEncParams.delta_qp[1][0] and AVVideoEncParams.delta_qp[2][0]
+     * - per-slice QP delta and chroma QP offsets, not exported directly
+     * - per-CU QP delta, not exported directly; one AVVideoBlockParams is
+     *   exported per coding unit, and the final QP_Y of the coding unit
+     *   minus AVVideoEncParams.qp is exported as AVVideoBlockParams.delta_qp.
+     *   QP_Y can be negative for bit depths above 8.
+     */
+    AV_VIDEO_ENC_PARAMS_HEVC,
 };
 
