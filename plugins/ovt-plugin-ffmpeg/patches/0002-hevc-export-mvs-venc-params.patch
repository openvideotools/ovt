+/**
+ * Export the motion vectors of the decoded picture as
+ * AV_FRAME_DATA_MOTION_VECTORS: one AVMotionVector per list and per unit of
+ * the motion vector field (min_pu_size x min_pu_size luma samples, the
+ * granularity of tab_mvf), in raster order, list 0 before list 1. Intra units
+ * have no vectors. The vectors are in quarter samples (motion_scale 4);
+ * source is -1 for list 0 and +1 for list 1. Positions are in the coded
+ * picture, before cropping.
+ */
+static int export_mvs(const HEVCLayerContext *l, AVFrame *f)
+{
+    const HEVCSPS *sps   = l->sps;
+    const MvField *tab   = l->cur_frame->tab_mvf;
+    const int log2_unit  = sps->log2_min_pu_size;
+    const int unit       = 1 << log2_unit;
+    const int nb_units   = sps->min_pu_width * sps->min_pu_height;
+    AVFrameSideData *sd;
+    AVMotionVector *mv;
+    size_t nb_mvs = 0;
+
+    for (int i = 0; i < nb_units; i++)
+        nb_mvs += !!(tab[i].pred_flag & PF_L0) + !!(tab[i].pred_flag & PF_L1);
+    if (!nb_mvs)
+        return 0;
+
+    sd = av_frame_new_side_data(f, AV_FRAME_DATA_MOTION_VECTORS,
+                                nb_mvs * sizeof(*mv));
+    if (!sd)
+        return AVERROR(ENOMEM);
+    mv = (AVMotionVector *)sd->data;
+
+    for (int y = 0; y < sps->min_pu_height; y++) {
+        for (int x = 0; x < sps->min_pu_width; x++) {
+            const MvField *mvf = &tab[y * sps->min_pu_width + x];
+            for (int list = 0; list < 2; list++) {
+                if (!(mvf->pred_flag & (PF_L0 << list)))
+                    continue;
+                mv->source       = list ? 1 : -1;
+                mv->w            = unit;
+                mv->h            = unit;
+                mv->dst_x        = (x << log2_unit) + unit / 2;
+                mv->dst_y        = (y << log2_unit) + unit / 2;
+                mv->motion_x     = mvf->mv[list].x;
+                mv->motion_y     = mvf->mv[list].y;
+                mv->motion_scale = 4;
+                mv->src_x        = mv->dst_x + mv->motion_x / 4;
+                mv->src_y        = mv->dst_y + mv->motion_y / 4;
+                mv->flags        = 0;
+                mv++;
+            }
+        }
+    }
+    return 0;
+}
+
+/**
+ * Export the quantisation parameters of the decoded picture as
+ * AV_FRAME_DATA_VIDEO_ENC_PARAMS of type AV_VIDEO_ENC_PARAMS_HEVC: one block
+ * per coding unit, in raster order of the CU's top-left corner.
+ */
+static int export_enc_params(const HEVCLayerContext *l, AVFrame *f)
+{
+    const HEVCSPS *sps     = l->sps;
+    const HEVCPPS *pps     = l->cur_frame->pps;
+    const int log2_min_cb  = sps->log2_min_cb_size;
+    AVVideoEncParams *par;
+    unsigned nb_blocks = 0, i = 0;
+
+#define CU_LOG2_SIZE(idx) FFMAX(sps->log2_ctb_size - l->tab_ct_depth[idx], log2_min_cb)
+#define CU_ORIGIN(x_cb, y_cb, log2_cb) \
+    (!((x_cb) & ((1 << ((log2_cb) - log2_min_cb)) - 1)) && \
+     !((y_cb) & ((1 << ((log2_cb) - log2_min_cb)) - 1)))
+
+    for (int y_cb = 0; y_cb < sps->min_cb_height; y_cb++)
+        for (int x_cb = 0; x_cb < sps->min_cb_width; x_cb++) {
+            const int idx = y_cb * sps->min_cb_width + x_cb;
+            nb_blocks += CU_ORIGIN(x_cb, y_cb, CU_LOG2_SIZE(idx));
+        }
+
+    par = av_video_enc_params_create_side_data(f, AV_VIDEO_ENC_PARAMS_HEVC, nb_blocks);
+    if (!par)
+        return AVERROR(ENOMEM);
+
+    par->qp             = 26 + pps->pic_init_qp_minus26;
+    par->delta_qp[1][0] = pps->cb_qp_offset;
+    par->delta_qp[2][0] = pps->cr_qp_offset;
+
+    for (int y_cb = 0; y_cb < sps->min_cb_height; y_cb++)
+        for (int x_cb = 0; x_cb < sps->min_cb_width; x_cb++) {
+            const int idx     = y_cb * sps->min_cb_width + x_cb;
+            const int log2_cb = CU_LOG2_SIZE(idx);
+            AVVideoBlockParams *b;
+
+            if (!CU_ORIGIN(x_cb, y_cb, log2_cb))
+                continue;
+            b           = av_video_enc_params_block(par, i++);
+            b->src_x    = x_cb << log2_min_cb;
+            b->src_y    = y_cb << log2_min_cb;
+            b->w        = 1 << log2_cb;
+            b->h        = 1 << log2_cb;
+            b->delta_qp = l->qp_y_tab[idx] - par->qp;
+        }
+#undef CU_LOG2_SIZE
+#undef CU_ORIGIN
+    return 0;
+}
+
 static int hevc_frame_end(HEVCContext *s, HEVCLayerContext *l)
 {
     HEVCFrame *out = l->cur_frame;
@@ -3440,6 +3560,16 @@ static int hevc_frame_end(HEVCContext *s, HEVCLayerContext *l)
             if (ret < 0 && s->avctx->err_recognition & AV_EF_EXPLODE)
                 return ret;
         }
+        if (s->avctx->export_side_data & AV_CODEC_EXPORT_DATA_MVS) {
+            ret = export_mvs(l, out->f);
+            if (ret < 0)
+                return ret;
+        }
+        if (s->avctx->export_side_data & AV_CODEC_EXPORT_DATA_VIDEO_ENC_PARAMS) {
+            ret = export_enc_params(l, out->f);
+            if (ret < 0)
+                return ret;
+        }
     }
     s->sei.picture_hash.is_md5 = 0;
 
@@ -3604,6 +3734,7 @@ fail:
 static int decode_nal_units(HEVCContext *s, const uint8_t *buf, int length)
 {
     int i, ret = 0;
+    unsigned export_deferred = 0;
     int eos_at_start = 1;
     int flags = (H2645_FLAG_IS_NALFF * !!s->is_nalff) | H2645_FLAG_SMALL_PADDING;
 
@@ -3697,10 +3828,32 @@ fail:
         if (ret >= 0)
             ret = hevc_frame_end(s, l);
 
+        if (l->cur_frame->export_pending) {
+            l->cur_frame->export_pending = 0;
+            export_deferred |= 1 << i;
+        }
+
         if (s->avctx->active_thread_type == FF_THREAD_FRAME)
             ff_progress_frame_report(&l->cur_frame->tf, INT_MAX);
     }
 
+    // Output the frames whose output waited for their side data. With frame
+    // threads the DPB state was already handed to the next thread, which
+    // outputs them instead.
+    for (int i = 0; i < FF_ARRAY_ELEMS(s->layers); i++) {
+        const HEVCSPS *sps = s->layers[i].sps;
+        int ret2;
+
+        if (!(export_deferred & (1 << i)) ||
+            s->avctx->active_thread_type == FF_THREAD_FRAME)
+            continue;
+        ret2 = ff_hevc_output_frames(s, s->layers_active_decode, s->layers_active_output,
+                                     sps->temporal_layer[sps->max_sub_layers - 1].num_reorder_pics,
+                                     sps->temporal_layer[sps->max_sub_layers - 1].max_dec_pic_buffering, 0);
+        if (ret2 < 0 && ret >= 0)
+            ret = ret2;
+    }
+
     return ret;
 }
 
