+
+fate-hevc-mvs: CMD = framecrc -flags2 +export_mvs -threads 1 -i $(TARGET_SAMPLES)/hevc-conformance/AMP_A_Samsung_6.bit -vf codecview=mv=pf+bf+bb -frames:v 8
+fate-hevc-mvs-frame-threads: CMD = framecrc -flags2 +export_mvs -threads 4 -thread_type frame -i $(TARGET_SAMPLES)/hevc-conformance/AMP_A_Samsung_6.bit -vf codecview=mv=pf+bf+bb -frames:v 8
+fate-hevc-mvs-frame-threads: REF = $(SRC_PATH)/tests/ref/fate/hevc-mvs
+FATE_HEVC-$(call FRAMECRC, HEVC, HEVC, HEVC_PARSER CODECVIEW_FILTER) += fate-hevc-mvs fate-hevc-mvs-frame-threads
+
 FATE_SAMPLES_AVCONV += $(FATE_HEVC-yes)
 FATE_SAMPLES_FFPROBE += $(FATE_HEVC_FFPROBE-yes)
 
