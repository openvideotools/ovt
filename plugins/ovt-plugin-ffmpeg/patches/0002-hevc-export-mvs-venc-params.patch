+                                AV_CODEC_EXPORT_DATA_VIDEO_ENC_PARAMS)
+
 void ff_hevc_unref_frame(HEVCFrame *frame, int flags);
 
 void ff_hevc_set_neighbour_available(HEVCLocalContext *lc, int x0, int y0,
