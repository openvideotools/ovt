+# export_side_data venc_params (per-CU QP) and mvs (drawn by codecview).
+# The -frame-threads variants must match the single-threaded reference.
+fate-hevc-encparams: CMD = venc_data $(TARGET_SAMPLES)/hevc-conformance/DELTAQP_B_SONY_3.bit 0 3
