+/* The film grain frame was set up before the side data computed from the
+ * decoded picture existed; give it the same buffers. */
+static int copy_block_side_data(AVFrame *dst, const AVFrame *src)
+{
+    static const enum AVFrameSideDataType types[] = {
+        AV_FRAME_DATA_MOTION_VECTORS,
+        AV_FRAME_DATA_VIDEO_ENC_PARAMS,
+    };
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(types); i++) {
+        const AVFrameSideData *sd = av_frame_get_side_data(src, types[i]);
+        AVBufferRef *buf;
+
+        if (!sd || av_frame_get_side_data(dst, types[i]))
+            continue;
+        buf = av_buffer_ref(sd->buf);
+        if (!buf)
+            return AVERROR(ENOMEM);
+        if (!av_frame_new_side_data_from_buf(dst, types[i], buf)) {
+            av_buffer_unref(&buf);
+            return AVERROR(ENOMEM);
+        }
+    }
+    return 0;
+}
+
 static void unref_missing_refs(HEVCLayerContext *l)
 {
     for (int i = 0; i < FF_ARRAY_ELEMS(l->DPB); i++) {
@@ -265,6 +293,20 @@ int ff_hevc_output_frames(HEVCContext *s,
             AVFrame *f = frame->needs_fg ? frame->frame_grain : frame->f;
             int output = !discard && (layers_active_output & (1 << min_layer));
 
+            if (output && (s->avctx->export_side_data & HEVC_EXPORT_BLOCK_DATA) &&
+                !s->avctx->hwaccel) {
+                // the side data is attached when the frame is decoded
+                if (frame->export_pending)
+                    return 0;
+                if (s->avctx->active_thread_type == FF_THREAD_FRAME)
+                    ff_progress_frame_await(&frame->tf, INT_MAX);
+                if (frame->needs_fg) {
+                    ret = copy_block_side_data(f, frame->f);
+                    if (ret < 0)
+                        return ret;
+                }
+            }
+
             if (output) {
                 f->pkt_dts = s->pkt_dts;
                 ret = ff_container_fifo_write(s->output_fifo, f);
