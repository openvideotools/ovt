@@ -3256,6 +3262,13 @@ static int hevc_frame_start(HEVCContext *s, HEVCLayerContext *l,
     if (ret < 0)
         goto fail;
 
+    s->cur_frame->export_pending = (s->avctx->export_side_data & HEVC_EXPORT_BLOCK_DATA) &&
