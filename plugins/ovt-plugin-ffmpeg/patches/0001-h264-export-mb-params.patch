+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "buffer.h"
+#include "frame.h"
+#include "mem.h"
+#include "video_block_params.h"
+
+AVVideoBlockParamsHeader *
+av_video_block_params_alloc(enum AVVideoBlockParamsType type,
+                            unsigned int nb_blocks, size_t *out_size)
+{
+    struct TestStructH264 {
+        AVVideoBlockParamsHeader p;
+        AVH264MacroblockParams   b;
+    };
+    size_t blocks_offset, block_size, size;
+    AVVideoBlockParamsHeader *par;
+
+    switch (type) {
+    case AV_VIDEO_BLOCK_PARAMS_H264:
+        blocks_offset = offsetof(struct TestStructH264, b);
+        block_size    = sizeof(AVH264MacroblockParams);
+        break;
+    default:
+        return NULL;
+    }
+
+    size = blocks_offset;
+    if (nb_blocks > (SIZE_MAX - size) / block_size)
+        return NULL;
+    size += block_size * nb_blocks;
+
+    par = av_mallocz(size);
+    if (!par)
+        return NULL;
+
+    par->type          = type;
+    par->nb_blocks     = nb_blocks;
+    par->block_size    = block_size;
+    par->blocks_offset = blocks_offset;
+
+    if (out_size)
+        *out_size = size;
+
+    return par;
+}
+
+AVVideoBlockParamsHeader *
+av_video_block_params_create_side_data(AVFrame *frame,
+                                       enum AVVideoBlockParamsType type,
+                                       unsigned int nb_blocks)
+{
+    AVBufferRef              *buf;
+    AVVideoBlockParamsHeader *par;
+    size_t size;
+
+    par = av_video_block_params_alloc(type, nb_blocks, &size);
+    if (!par)
+        return NULL;
+    buf = av_buffer_create((uint8_t *)par, size, NULL, NULL, 0);
+    if (!buf) {
+        av_freep(&par);
+        return NULL;
+    }
+
+    if (!av_frame_new_side_data_from_buf(frame, AV_FRAME_DATA_VIDEO_BLOCK_PARAMS, buf)) {
+        av_buffer_unref(&buf);
+        return NULL;
+    }
+
+    return par;
+}
diff --git a/libavutil/video_block_params.h b/libavutil/video_block_params.h
new file mode 100644
index 0000000..ba66740
--- /dev/null
+++ b/libavutil/video_block_params.h
@@ -0,0 +1,235 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVUTIL_VIDEO_BLOCK_PARAMS_H
+#define AVUTIL_VIDEO_BLOCK_PARAMS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "libavutil/avassert.h"
+#include "libavutil/frame.h"
+
+/**
+ * @file
+ * Per-block syntax of a decoded video frame, exported by decoders as
+ * AV_FRAME_DATA_VIDEO_BLOCK_PARAMS side data.
+ *
+ * Where AV_FRAME_DATA_VIDEO_ENC_PARAMS carries only the final quantiser of
+ * each block, this side data carries the codec-specific syntax elements of
+ * each block (partitioning, prediction modes, reference indices, coded block
+ * pattern, motion vector differences) as signalled in the bitstream. The
+ * layout of each block record depends on the type.
+ */
+
+enum AVVideoBlockParamsType {
+    AV_VIDEO_BLOCK_PARAMS_NONE = -1,
+    /**
+     * H.264 macroblocks. Each block is an AVH264MacroblockParams describing
+     * one macroblock (or, in MBAFF frames, one macroblock of a macroblock
+     * pair), in raster order of the coded picture.
+     */
+    AV_VIDEO_BLOCK_PARAMS_H264 = 0,
+};
+
+/**
+ * Per-block parameters of a given frame. This struct is allocated along with
+ * an array of per-block records whose layout depends on the type.
+ * Must be allocated with av_video_block_params_alloc().
+ */
+typedef struct AVVideoBlockParamsHeader {
+    /**
+     * Number of blocks in the array.
+     *
+     * May be 0, in which case no per-block information is present. In this case
+     * the values of blocks_offset / block_size are unspecified and should not
+     * be accessed.
+     */
+    unsigned int nb_blocks;
+    /**
+     * Offset in bytes from the beginning of this structure at which the array
+     * of blocks starts.
+     */
+    size_t blocks_offset;
+    /**
+     * Size of each block in bytes. May not match the sizeof() of the record
+     * type as known to the caller.
+     */
+    size_t block_size;
+
+    /**
+     * Type of the parameters (the codec they are used with). It determines
+     * the type of each block record.
+     */
+    enum AVVideoBlockParamsType type;
+
+    /**
+     * Width and height of the block grid, in blocks. For H.264 these are the
+     * picture width and height in macroblocks. nb_blocks is normally
+     * plane_w * plane_h.
+     */
+    int plane_w, plane_h;
+} AVVideoBlockParamsHeader;
+
+/**
+ * Syntax of one H.264 macroblock, as signalled in the bitstream.
+ * It is allocated as a part of AVVideoBlockParamsHeader and should be
+ * retrieved with av_video_block_params_block().
+ *
+ * sizeof(AVH264MacroblockParams) is not a part of the ABI and new fields may
+ * be added to it.
+ *
+ * Unless stated otherwise, a value of -1 in a signed field means that the
+ * element is not present in this macroblock.
+ */
+typedef struct AVH264MacroblockParams {
+    /**
+     * Position of the top-left luma sample of the macroblock in the coded
+     * picture.
+     */
+    int32_t src_x, src_y;
+
+    /**
+     * Index of the slice this macroblock belongs to, counted from 0 in
+     * decoding order within the picture, modulo 256.
+     */
+    uint8_t slice_id;
+
+    /**
+     * Macroblock type class:
+     * 0 I_NxN, 1 I_16x16, 2 I_PCM, 3 P_16x16 (P_L0_16x16), 4 P_16x8,
+     * 5 P_8x16, 6 P_8x8 (including P_8x8ref0), 7 P_Skip, 8 B_Direct_16x16,
+     * 9 B_16x16, 10 B_16x8, 11 B_8x16, 12 B_8x8, 13 B_Skip.
+     * SI and SP macroblocks are reported as their I and P equivalents.
+     */
+    uint8_t mb_type_class;
+
+    /**
+     * Sub-macroblock partitioning of each 8x8 partition, for mb_type_class
+     * P_8x8 and B_8x8: bits 0-3 are 0 for 8x8, 1 for 8x4, 2 for 4x8,
+     * 3 for 4x4; bit 4 is set for B_Direct_8x8. 0 for other macroblock types.
+     */
+    uint8_t sub_mb_type[4];
+
+    /**
+     * Prediction direction of each 8x8 partition: bit 0 set when list 0 is
+     * used, bit 1 set when list 1 is used. 0 for intra macroblocks.
+     */
+    uint8_t pred_dir[4];
+
+    /**
+     * Reference index of each 8x8 partition for list 0 and list 1, or -1 when
+     * the list is not used by that partition.
+     */
+    int8_t ref_idx[2][4];
+
+    /**
+     * Intra 4x4 prediction mode of each 4x4 block, in the decoding order of
+     * the 4x4 luma blocks (H.264 6.4.3), for mb_type_class I_NxN without
+     * transform_8x8; -1 otherwise.
+     */
+    int8_t intra4x4_pred_mode[16];
+
+    /**
+     * Intra 8x8 prediction mode of each 8x8 block, for mb_type_class I_NxN
+     * with transform_8x8; -1 otherwise.
+     */
+    int8_t intra8x8_pred_mode[4];
+
+    /**
+     * Intra 16x16 prediction mode (0-3), for mb_type_class I_16x16;
+     * -1 otherwise.
+     */
+    int8_t intra16x16_pred_mode;
+
+    /**
+     * intra_chroma_pred_mode (0-3) of intra macroblocks with chroma; -1 for
+     * inter macroblocks, I_PCM and monochrome pictures.
+     */
+    int8_t intra_chroma_pred_mode;
+
+    /**
+     * coded_block_pattern: bits 0-3 luma, bits 4-5 chroma (CodedBlockPatternLuma
+     * + 16 * CodedBlockPatternChroma).
+     */
+    uint8_t cbp;
+
+    /**
+     * transform_size_8x8_flag.
+     */
+    uint8_t transform_8x8;
+
+    /**
+     * mb_field_decoding_flag; 1 also for every macroblock of a field picture.
+     */
+    uint8_t mb_field_decoding_flag;
+
+    /**
+     * mb_qp_delta as signalled, 0 when not present.
+     */
+    int8_t qp_delta;
+
+    /**
+     * Motion vector difference as signalled (mvd_l0 / mvd_l1), per list, per
+     * 4x4 block in the decoding order of the 4x4 luma blocks, horizontal then
+     * vertical component, in quarter luma sample units. 0 where no mvd is
+     * signalled.
+     */
+    int16_t mvd[2][16][2];
+} AVH264MacroblockParams;
+
+/**
+ * Get the block at the specified {@code idx}. Must be between 0 and
+ * nb_blocks - 1. The returned pointer is to a record of the type determined by
+ * par->type, e.g. AVH264MacroblockParams for AV_VIDEO_BLOCK_PARAMS_H264.
+ */
+static av_always_inline void*
+av_video_block_params_block(AVVideoBlockParamsHeader *par, unsigned int idx)
+{
+    av_assert0(idx < par->nb_blocks);
+    return (uint8_t *)par + par->blocks_offset + idx * par->block_size;
+}
+
+/**
+ * Allocates memory for AVVideoBlockParamsHeader of the given type, plus an
+ * array of {@code nb_blocks} records of the type's block structure, and
+ * initializes the variables. The blocks are zeroed. Can be freed with a normal
+ * av_free() call.
+ *
+ * @param out_size if non-NULL, the size in bytes of the resulting data array is
+ * written here.
+ * @return the allocated structure, or NULL on failure or for an unknown type
+ */
+AVVideoBlockParamsHeader *
+av_video_block_params_alloc(enum AVVideoBlockParamsType type,
+                            unsigned int nb_blocks, size_t *out_size);
+
+/**
+ * Allocates memory for AVVideoBlockParamsHeader plus an array of
+ * {@code nb_blocks} block records in the given AVFrame {@code frame}
+ * as AVFrameSideData of type AV_FRAME_DATA_VIDEO_BLOCK_PARAMS
+ * and initializes the variables.
+ *
+ * @return the allocated structure, or NULL on failure or for an unknown type
+ */
+AVVideoBlockParamsHeader *
+av_video_block_params_create_side_data(AVFrame *frame,
+                                       enum AVVideoBlockParamsType type,
+                                       unsigned int nb_blocks);
+
+#endif /* AVUTIL_VIDEO_BLOCK_PARAMS_H */
