+static int h264_export_block_params(const H264Context *h, AVFrame *f,
+                                    const H264Picture *p)
+{
+    AVVideoBlockParamsHeader *par;
+    const unsigned int nb_mb = p->mb_height * p->mb_width;
+
+    /* With frame threading, the picture may still be decoded by another
+     * thread; its progress is reported even when it is not a reference
+     * picture (see alloc_picture()). */
+    if (h->avctx->active_thread_type & FF_THREAD_FRAME) {
+        if (!p->field_picture) {
+            ff_thread_await_progress(&p->tf, INT_MAX, 0);
+        } else {
+            for (int i = 0; i < 2; i++)
+                if (p->field_poc[i] != INT_MAX)
+                    ff_thread_await_progress(&p->tf, INT_MAX, i);
+        }
+    }
+
+    par = av_video_block_params_create_side_data(f, AV_VIDEO_BLOCK_PARAMS_H264, nb_mb);
+    if (!par)
+        return AVERROR(ENOMEM);
+    par->plane_w = p->mb_width;
+    par->plane_h = p->mb_height;
+
+    for (int y = 0; y < p->mb_height; y++)
+        for (int x = 0; x < p->mb_width; x++) {
+            const int mb_xy        = y * p->mb_stride + x;
+            const H264MBParams *s  = &p->mb_params[mb_xy];
+            const uint32_t mb_type = p->mb_type[mb_xy];
+            AVH264MacroblockParams *b = av_video_block_params_block(par, y * p->mb_width + x);
+
+            b->src_x = x * 16;
+            b->src_y = y * 16;
+            memset(b->ref_idx,            -1, sizeof(b->ref_idx));
+            memset(b->intra4x4_pred_mode, -1, sizeof(b->intra4x4_pred_mode));
+            memset(b->intra8x8_pred_mode, -1, sizeof(b->intra8x8_pred_mode));
+            b->intra16x16_pred_mode   = -1;
+            b->intra_chroma_pred_mode = -1;
+
+            if (!s->slice_num) {
+                b->mb_type_class = 255;
+                continue;
+            }
+
+            b->slice_id               = s->slice_num - 1;
+            b->mb_type_class          = s->mb_type_class;
+            b->cbp                    = s->cbp;
+            b->transform_8x8          = !!IS_8x8DCT(mb_type);
+            b->mb_field_decoding_flag = !!IS_INTERLACED(mb_type);
+            b->qp_delta               = s->qp_delta;
+            memcpy(b->mvd, s->mvd, sizeof(b->mvd));
+
+            if (s->mb_type_class <= 2) {
+                if (s->mb_type_class == 0) {
+                    if (b->transform_8x8) {
+                        for (int i = 0; i < 4; i++)
+                            b->intra8x8_pred_mode[i] = s->intra4x4_pred_mode[4 * i];
+                    } else {
+                        memcpy(b->intra4x4_pred_mode, s->intra4x4_pred_mode,
+                               sizeof(b->intra4x4_pred_mode));
+                    }
+                } else if (s->mb_type_class == 1) {
+                    b->intra16x16_pred_mode = s->intra16x16_pred_mode;
+                }
+                if (s->mb_type_class != 2)
+                    b->intra_chroma_pred_mode = s->intra_chroma_pred_mode;
+                continue;
+            }
+
+            if (s->mb_type_class == 6 || s->mb_type_class == 12)
+                memcpy(b->sub_mb_type, s->sub_mb_type, sizeof(b->sub_mb_type));
+
+            for (int list = 0; list < 2; list++) {
+                if (!USES_LIST(mb_type, list) || (list && s->mb_type_class < 8))
+                    continue;
+                for (int i = 0; i < 4; i++) {
+                    const int ref = p->ref_index[list][4 * mb_xy + i];
+                    if (ref >= 0) {
+                        b->ref_idx[list][i] = ref;
+                        b->pred_dir[i]     |= 1 << list;
+                    }
+                }
+            }
+        }
+
+    return 0;
+}
