diff --git a/libavutil/tests/video_block_params.c b/libavutil/tests/video_block_params.c
new file mode 100644
index 0000000..e15370f
--- /dev/null
+++ b/libavutil/tests/video_block_params.c
@@ -0,0 +1,171 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "libavutil/frame.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixfmt.h"
+#include "libavutil/video_block_params.h"
+
+/* 1920x1088 in macroblocks */
+#define MB_W 120
+#define MB_H  68
+
+/* Deterministic, index-dependent values covering the full range of each field. */
+static void fill_mb(AVH264MacroblockParams *mb, unsigned idx)
+{
+    mb->src_x                  = (idx % MB_W) * 16;
+    mb->src_y                  = (idx / MB_W) * 16;
+    mb->slice_id               = idx / 255;
+    mb->mb_type_class          = idx % 14;
+    mb->intra16x16_pred_mode   = (int8_t)(idx % 5) - 1;
+    mb->intra_chroma_pred_mode = (int8_t)(idx % 5) - 1;
+    mb->cbp                    = idx % 48;
+    mb->transform_8x8          = idx & 1;
+    mb->mb_field_decoding_flag = (idx >> 1) & 1;
+    mb->qp_delta               = (int8_t)(idx % 52) - 26;
+    for (int i = 0; i < 4; i++) {
+        mb->sub_mb_type[i]       = (idx + i) % 4 | (((idx >> i) & 1) << 4);
+        mb->pred_dir[i]          = (idx + i) % 4;
+        mb->ref_idx[0][i]        = (int8_t)((idx + i) % 33) - 1;
+        mb->ref_idx[1][i]        = (int8_t)((idx + 7 * i) % 33) - 1;
+        mb->intra8x8_pred_mode[i] = (int8_t)((idx + i) % 10) - 1;
+    }
+    for (int i = 0; i < 16; i++) {
+        mb->intra4x4_pred_mode[i] = (int8_t)((idx + i) % 10) - 1;
+        for (int list = 0; list < 2; list++) {
+            mb->mvd[list][i][0] = (int16_t)((idx * 31 + i * 7 + list) % 65536 - 32768);
+            mb->mvd[list][i][1] = (int16_t)((idx * 17 + i * 3 + list) % 65536 - 32768);
+        }
+    }
+}
+
+static int check_mb(const AVH264MacroblockParams *mb, unsigned idx)
+{
+    AVH264MacroblockParams ref;
+
+    memset(&ref, 0, sizeof(ref));
+    fill_mb(&ref, idx);
+#define CHECK(field) if (memcmp(&mb->field, &ref.field, sizeof(ref.field))) { \
+        printf("block %u: " #field " mismatch\n", idx);                       \
+        return 1;                                                             \
+    }
+    CHECK(src_x);
+    CHECK(src_y);
+    CHECK(slice_id);
+    CHECK(mb_type_class);
+    CHECK(sub_mb_type);
+    CHECK(pred_dir);
+    CHECK(ref_idx);
+    CHECK(intra4x4_pred_mode);
+    CHECK(intra8x8_pred_mode);
+    CHECK(intra16x16_pred_mode);
+    CHECK(intra_chroma_pred_mode);
+    CHECK(cbp);
+    CHECK(transform_8x8);
+    CHECK(mb_field_decoding_flag);
+    CHECK(qp_delta);
+    CHECK(mvd);
+#undef CHECK
+    return 0;
+}
+
+int main(void)
+{
+    const unsigned nb_blocks = MB_W * MB_H;
+    AVVideoBlockParamsHeader *par;
+    const AVFrameSideData *sd;
+    AVFrame *frame, *clone;
+    size_t size;
+    int errors = 0;
+
+    /* plain allocation */
+    par = av_video_block_params_alloc(AV_VIDEO_BLOCK_PARAMS_H264, nb_blocks, &size);
+    if (!par)
+        return 1;
+    printf("alloc: type %d, nb_blocks %u, block_size ok %d, size ok %d\n",
+           par->type, par->nb_blocks,
+           par->block_size == sizeof(AVH264MacroblockParams),
+           size == par->blocks_offset + (size_t)nb_blocks * par->block_size);
+    printf("alloc: blocks zeroed %d\n",
+           ((AVH264MacroblockParams *)av_video_block_params_block(par, nb_blocks - 1))->src_x == 0);
+    av_free(par);
+
+    par = av_video_block_params_alloc(AV_VIDEO_BLOCK_PARAMS_H264, 0, &size);
+    if (!par)
+        return 1;
+    printf("alloc: empty, nb_blocks %u, size ok %d\n", par->nb_blocks,
+           size == par->blocks_offset);
+    av_free(par);
+
+    printf("alloc: unknown type NULL %d\n",
+           !av_video_block_params_alloc(AV_VIDEO_BLOCK_PARAMS_NONE, 16, NULL));
+
+    /* side data round trip */
+    frame = av_frame_alloc();
+    if (!frame)
+        return 1;
+    /* av_frame_clone() needs refcounted data */
+    frame->format = AV_PIX_FMT_GRAY8;
+    frame->width  = 16;
+    frame->height = 16;
+    if (av_frame_get_buffer(frame, 0) < 0) {
+        av_frame_free(&frame);
+        return 1;
+    }
+    printf("side data: unknown type NULL %d, nb_side_data %d\n",
+           !av_video_block_params_create_side_data(frame, AV_VIDEO_BLOCK_PARAMS_NONE, 16),
+           frame->nb_side_data);
+
+    par = av_video_block_params_create_side_data(frame, AV_VIDEO_BLOCK_PARAMS_H264,
+                                                 nb_blocks);
+    if (!par) {
+        av_frame_free(&frame);
+        return 1;
+    }
+    par->plane_w = MB_W;
+    par->plane_h = MB_H;
+    for (unsigned i = 0; i < nb_blocks; i++)
+        fill_mb(av_video_block_params_block(par, i), i);
+
+    clone = av_frame_clone(frame);
+    av_frame_free(&frame);
+    if (!clone)
+        return 1;
+
+    sd = av_frame_get_side_data(clone, AV_FRAME_DATA_VIDEO_BLOCK_PARAMS);
+    if (!sd) {
+        printf("side data: not found\n");
+        av_frame_free(&clone);
+        return 1;
+    }
+    par = (AVVideoBlockParamsHeader *)sd->data;
+    printf("side data: %s, size ok %d\n", av_frame_side_data_name(sd->type),
+           sd->size == par->blocks_offset + (size_t)par->nb_blocks * par->block_size);
+    printf("side data: type %d, nb_blocks %u, plane %dx%d\n",
+           par->type, par->nb_blocks, par->plane_w, par->plane_h);
+    for (unsigned i = 0; i < par->nb_blocks && !errors; i++)
+        errors += check_mb(av_video_block_params_block(par, i), i);
+    printf("side data: %u blocks round-tripped, errors %d\n", par->nb_blocks, errors);
+
+    av_frame_free(&clone);
+    return errors;
+}
