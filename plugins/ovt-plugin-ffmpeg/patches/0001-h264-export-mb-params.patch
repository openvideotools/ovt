diff --git a/tools/vblock_data_dump.c b/tools/vblock_data_dump.c
new file mode 100644
index 0000000..68f8495
--- /dev/null
+++ b/tools/vblock_data_dump.c
@@ -0,0 +1,142 @@
+/*
