+// Version of the extended inspection data below (fields after uv_palette in
+// insp_mi_data, the frame-level loop filter, CDEF, global motion and loop
+// restoration data in insp_frame_data). Absent from older libaom versions.
+#define INSPECTION_EXT_VERSION 1
+
 typedef struct insp_mi_data insp_mi_data;
 
 struct insp_mi_data {
@@ -55,6 +60,47 @@ struct insp_mi_data {
   int16_t intrabc;
   int16_t palette;
   int16_t uv_palette;
+  // Extension (INSPECTION_EXT_VERSION 1). -1 where a field does not apply.
+  int16_t partition;           // PARTITION_TYPE of the containing square
+  int16_t angle_delta[2];      // [PLANE_TYPE_Y], [PLANE_TYPE_UV]
+  int16_t filter_intra_mode;   // FILTER_INTRA_MODE, -1 without filter intra
+  int16_t interintra_mode;     // INTERINTRA_MODE, -1 unless interintra
+  int16_t wedge_interintra;    // use_wedge_interintra, -1 unless interintra
+  int16_t interintra_wedge_index;
+  int16_t interinter_comp_type;  // COMPOUND_TYPE, -1 unless compound
+  int16_t wedge_index;
+  int16_t wedge_sign;
+  int16_t mask_type;
+  int16_t comp_group_idx;
+  int16_t compound_idx;
+  int16_t ref_mv_idx;  // DRL index, -1 for intra blocks
+  int16_t skip_mode;
+  int16_t seg_id_predicted;
+  int16_t wm_type;     // TransformationType, -1 unless WARPED_CAUSAL
+  int16_t wm_invalid;
+  int16_t num_proj_ref;  // -1 for intra blocks
+  int16_t overlappable_neighbors;
+  int16_t delta_lf_from_base;
+  int16_t delta_lf[4];  // FRAME_LF_COUNT
+  int16_t cdef_idx;     // cdef_strength index of the 64x64, -1 if not coded
+  int16_t inter_tx_size[16];  // INTER_TX_SIZE_BUF_LEN
+  int16_t mvd[2][2];  // [ref][row, col], 1/8 pel; INSPECTION_MVD_NONE if none
+  int16_t mv_joint[2];  // MV_JOINT_TYPE per ref, -1 without NEWMV
+  uint16_t palette_colors[3][8];  // [plane][i] for i < palette size
+  int32_t wm_params[6];
+};
+
+#define INSPECTION_MVD_NONE (-32768)
+
+typedef struct insp_lr_unit insp_lr_unit;
+
+// One loop restoration unit: RestorationUnitInfo of the frame.
+struct insp_lr_unit {
+  int16_t restoration_type;  // RestorationType
+  int16_t wiener_vfilter[3];  // coded taps 0..2 (the filter is symmetric)
+  int16_t wiener_hfilter[3];
+  int16_t sgrproj_ep;
+  int16_t sgrproj_xqd[2];
 };
 
 typedef struct insp_frame_data insp_frame_data;
@@ -79,6 +125,30 @@ struct insp_frame_data {
   int delta_q_present_flag;
   int delta_q_res;
   int show_existing_frame;
+  // Extension (INSPECTION_EXT_VERSION 1): frame-level filter parameters.
+  int lf_filter_level[4];  // Y vertical, Y horizontal, U, V
+  int lf_sharpness_level;
+  int lf_mode_ref_delta_enabled;
+  int lf_ref_deltas[8];
+  int lf_mode_deltas[2];
+  int delta_lf_present_flag;
+  int delta_lf_res;
+  int delta_lf_multi;
+  int cdef_damping;
+  int cdef_bits;
+  int cdef_strengths[16];  // CDEF_MAX_STRENGTHS; 1 << cdef_bits used
+  int cdef_uv_strengths[16];
+  int gm_type[8];  // per reference frame type, [0] unused
+  int32_t gm_params[8][6];
+  // Loop restoration units of each plane in raster order; lr_units[p] holds
+  // lr_horz_units[p] * lr_vert_units[p] entries and is NULL when the plane
+  // has no restoration (lr_frame_type[p] == RESTORE_NONE).
+  int lr_frame_type[3];
+  int lr_unit_size[3];
+  int lr_horz_units[3];
+  int lr_vert_units[3];
+  insp_lr_unit *lr_units[3];
+  int lr_units_alloc[3];
 };
 
 void ifd_init(insp_frame_data *fd, int frame_width, int frame_height);
