+// Local warp parameters: [[wmmat[0..5]], ...] per MI (int32, so not through
+// put_block_info, which reads int16 values).
+static int put_warp_params(char *buffer) {
+  const int mi_rows = frame_data.mi_rows;
+  const int mi_cols = frame_data.mi_cols;
+  char *buf = buffer;
+  buf += put_str(buf, "  \"wm_params\": [");
+  for (int r = 0; r < mi_rows; ++r) {
+    *(buf++) = '[';
+    for (int c = 0; c < mi_cols; ++c) {
+      const insp_mi_data *mi = &frame_data.mi_grid[r * mi_cols + c];
+      for (int k = 0; k < 6; ++k)
+        buf += put_num(buf, k == 0 ? '[' : ',', mi->wm_params[k], 0);
+      *(buf++) = ']';
+      if (c < mi_cols - 1) *(buf++) = ',';
+    }
+    *(buf++) = ']';
+    if (r < mi_rows - 1) *(buf++) = ',';
+  }
+  buf += put_str(buf, "],\n");
+  return (int)(buf - buffer);
+}
+
+// Loop restoration: per plane the frame type, unit size, unit grid and the
+// units as [type, vfilter[0..2], hfilter[0..2], ep, xqd[0], xqd[1]].
+static int put_loop_restoration(char *buffer) {
+  char *buf = buffer;
+  buf += put_str(buf, "  \"loopRestoration\": [");
+  for (int p = 0; p < 3; ++p) {
+    const int n = frame_data.lr_horz_units[p] * frame_data.lr_vert_units[p];
+    *(buf++) = '{';
+    buf += put_str(buf, "\"frameType\":");
+    buf += put_num(buf, 0, frame_data.lr_frame_type[p], 0);
+    buf += put_str(buf, ",\"unitSize\":");
+    buf += put_num(buf, 0, frame_data.lr_unit_size[p], 0);
+    buf += put_str(buf, ",\"horzUnits\":");
+    buf += put_num(buf, 0, frame_data.lr_horz_units[p], 0);
+    buf += put_str(buf, ",\"vertUnits\":");
+    buf += put_num(buf, 0, frame_data.lr_vert_units[p], 0);
+    buf += put_str(buf, ",\"units\":[");
+    for (int u = 0; u < n; ++u) {
+      const insp_lr_unit *lu = &frame_data.lr_units[p][u];
+      buf += put_num(buf, '[', lu->restoration_type, 0);
+      for (int k = 0; k < 3; ++k)
+        buf += put_num(buf, ',', lu->wiener_vfilter[k], 0);
+      for (int k = 0; k < 3; ++k)
+        buf += put_num(buf, ',', lu->wiener_hfilter[k], 0);
+      buf += put_num(buf, ',', lu->sgrproj_ep, 0);
+      buf += put_num(buf, ',', lu->sgrproj_xqd[0], 0);
+      buf += put_num(buf, ',', lu->sgrproj_xqd[1], ']');
+      if (u < n - 1) *(buf++) = ',';
+    }
+    buf += put_str(buf, "]}");
+    if (p < 2) *(buf++) = ',';
+  }
+  buf += put_str(buf, "],\n");
+  return (int)(buf - buffer);
+}
