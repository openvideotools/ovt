+// Frame-level loop filter, CDEF, global motion and loop restoration data.
+static void ifd_inspect_frame_filters(insp_frame_data *fd,
+                                      const AV1_COMMON *cm) {
+  const struct loopfilter *lf = &cm->lf;
+  fd->lf_filter_level[0] = lf->filter_level[0];
+  fd->lf_filter_level[1] = lf->filter_level[1];
+  fd->lf_filter_level[2] = lf->filter_level_u;
+  fd->lf_filter_level[3] = lf->filter_level_v;
+  fd->lf_sharpness_level = lf->sharpness_level;
+  fd->lf_mode_ref_delta_enabled = lf->mode_ref_delta_enabled;
+  for (int i = 0; i < REF_FRAMES; i++) fd->lf_ref_deltas[i] = lf->ref_deltas[i];
+  for (int i = 0; i < MAX_MODE_LF_DELTAS; i++)
+    fd->lf_mode_deltas[i] = lf->mode_deltas[i];
+  fd->delta_lf_present_flag = cm->delta_q_info.delta_lf_present_flag;
+  fd->delta_lf_res = cm->delta_q_info.delta_lf_res;
+  fd->delta_lf_multi = cm->delta_q_info.delta_lf_multi;
+  const CdefInfo *cdef = &cm->cdef_info;
+  fd->cdef_damping = cdef->cdef_damping;
+  fd->cdef_bits = cdef->cdef_bits;
+  for (int i = 0; i < CDEF_MAX_STRENGTHS; i++) {
+    fd->cdef_strengths[i] = cdef->cdef_strengths[i];
+    fd->cdef_uv_strengths[i] = cdef->cdef_uv_strengths[i];
+  }
+  for (int t = 0; t < REF_FRAMES; t++) {
+    fd->gm_type[t] = cm->global_motion[t].wmtype;
+    for (int k = 0; k < 6; k++)
+      fd->gm_params[t][k] = cm->global_motion[t].wmmat[k];
+  }
+  const int num_planes = av1_num_planes(cm);
+  for (int p = 0; p < 3; p++) {
+    const RestorationInfo *rsi = &cm->rst_info[p];
+    const int used = p < num_planes &&
+                     rsi->frame_restoration_type != RESTORE_NONE &&
+                     rsi->unit_info != NULL;
+    fd->lr_frame_type[p] = p < num_planes ? rsi->frame_restoration_type : 0;
+    fd->lr_unit_size[p] = used ? rsi->restoration_unit_size : 0;
+    fd->lr_horz_units[p] = used ? rsi->horz_units : 0;
+    fd->lr_vert_units[p] = used ? rsi->vert_units : 0;
+    const int n = fd->lr_horz_units[p] * fd->lr_vert_units[p];
+    if (n > fd->lr_units_alloc[p]) {
+      aom_free(fd->lr_units[p]);
+      fd->lr_units[p] =
+          (insp_lr_unit *)aom_malloc(sizeof(*fd->lr_units[p]) * n);
+      if (!fd->lr_units[p]) {
+        fprintf(stderr, "Error allocating inspection data\n");
+        abort();
+      }
+      fd->lr_units_alloc[p] = n;
+    }
+    for (int u = 0; u < n; u++) {
+      const RestorationUnitInfo *ru = &rsi->unit_info[u];
+      insp_lr_unit *out = &fd->lr_units[p][u];
+      out->restoration_type = ru->restoration_type;
+      for (int k = 0; k < 3; k++) {
+        out->wiener_vfilter[k] = ru->wiener_info.vfilter[k];
+        out->wiener_hfilter[k] = ru->wiener_info.hfilter[k];
+      }
+      out->sgrproj_ep = ru->sgrproj_info.ep;
+      out->sgrproj_xqd[0] = ru->sgrproj_info.xqd[0];
+      out->sgrproj_xqd[1] = ru->sgrproj_info.xqd[1];
+    }
+  }
+}
+
+// Mode info fields of INSPECTION_EXT_VERSION 1 for one MI.
+static void ifd_inspect_mi_ext(insp_mi_data *mi, const MB_MODE_INFO *mbmi,
+                               const CommonModeInfoParams *mi_params, int row,
+                               int col) {
+  const int inter = is_inter_block(mbmi) && !is_intrabc_block(mbmi);
+  const int compound = has_second_ref(mbmi);
+  const int interintra = is_interintra_pred(mbmi);
+  mi->partition = mbmi->partition;
+  // The decoder leaves stale angle deltas in non-directional and inter blocks.
+  const int intra = !is_inter_block(mbmi) && !is_intrabc_block(mbmi);
+  mi->angle_delta[0] = intra && av1_is_directional_mode(mbmi->mode)
+                           ? mbmi->angle_delta[PLANE_TYPE_Y]
+                           : 0;
+  mi->angle_delta[1] =
+      intra && av1_is_directional_mode(get_uv_mode(mbmi->uv_mode))
+          ? mbmi->angle_delta[PLANE_TYPE_UV]
+          : 0;
+  mi->filter_intra_mode =
+      mbmi->filter_intra_mode_info.use_filter_intra
+          ? mbmi->filter_intra_mode_info.filter_intra_mode
+          : -1;
+  mi->interintra_mode = interintra ? mbmi->interintra_mode : -1;
+  mi->wedge_interintra = interintra ? mbmi->use_wedge_interintra : -1;
+  mi->interintra_wedge_index =
+      interintra && mbmi->use_wedge_interintra ? mbmi->interintra_wedge_index
+                                               : -1;
+  mi->interinter_comp_type = compound ? mbmi->interinter_comp.type : -1;
+  mi->wedge_index = compound ? mbmi->interinter_comp.wedge_index : -1;
+  mi->wedge_sign = compound ? mbmi->interinter_comp.wedge_sign : -1;
+  mi->mask_type = compound ? mbmi->interinter_comp.mask_type : -1;
+  mi->comp_group_idx = compound ? mbmi->comp_group_idx : -1;
+  mi->compound_idx = compound ? mbmi->compound_idx : -1;
+  mi->ref_mv_idx = inter ? mbmi->ref_mv_idx : -1;
+  mi->skip_mode = mbmi->skip_mode;
+  mi->seg_id_predicted = mbmi->seg_id_predicted;
+  const int warped = inter && mbmi->motion_mode == WARPED_CAUSAL;
+  mi->wm_type = warped ? mbmi->wm_params.wmtype : -1;
+  mi->wm_invalid = warped ? mbmi->wm_params.invalid : -1;
+  for (int k = 0; k < 6; k++)
+    mi->wm_params[k] = warped ? mbmi->wm_params.wmmat[k] : 0;
+  mi->num_proj_ref = inter ? mbmi->num_proj_ref : -1;
+  mi->overlappable_neighbors = inter ? mbmi->overlappable_neighbors : -1;
+  mi->delta_lf_from_base = mbmi->delta_lf_from_base;
+  for (int k = 0; k < FRAME_LF_COUNT; k++) mi->delta_lf[k] = mbmi->delta_lf[k];
+  // The strength index is stored in the block at the origin of its 64x64.
+  const int cdef_size = MI_SIZE_64X64;
+  const MB_MODE_INFO *cdef_mbmi =
+      mi_params->mi_grid_base[(row & ~(cdef_size - 1)) * mi_params->mi_stride +
+                              (col & ~(cdef_size - 1))];
+  mi->cdef_idx = cdef_mbmi != NULL ? cdef_mbmi->cdef_strength : -1;
+  for (int k = 0; k < INTER_TX_SIZE_BUF_LEN; k++)
+    mi->inter_tx_size[k] = mbmi->inter_tx_size[k];
+  for (int k = 0; k < 2; k++) {
+    mi->mvd[k][0] = inter ? mbmi->insp_mvd[k][0] : INSPECTION_MVD_NONE;
+    mi->mvd[k][1] = inter ? mbmi->insp_mvd[k][1] : INSPECTION_MVD_NONE;
+    mi->mv_joint[k] = inter ? mbmi->insp_mv_joint[k] : -1;
+  }
+  const PALETTE_MODE_INFO *pmi = &mbmi->palette_mode_info;
+  for (int p = 0; p < 3; p++) {
+    const int n = pmi->palette_size[p > 0];
+    for (int i = 0; i < PALETTE_MAX_SIZE; i++)
+      mi->palette_colors[p][i] =
+          i < n ? pmi->palette_colors[p * PALETTE_MAX_SIZE + i] : 0;
+  }
 }
 
