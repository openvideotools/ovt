diff --git a/av1/decoder/decodemv.c b/av1/decoder/decodemv.c
index 7d8971d..bd3e831 100644
--- a/av1/decoder/decodemv.c
+++ b/av1/decoder/decodemv.c
@@ -1379,6 +1379,27 @@ static void read_inter_block_mode_info(AV1Decoder *const pbi,
                  nearestmv, nearmv, is_compound, allow_hp, r);
   aom_merge_corrupted_flag(&dcb->corrupted, mv_corrupted_flag);
 
+#if CONFIG_INSPECTION
+  // read_mv() sets mv = ref_mv + diff, and a coded component is never 0, so
+  // the difference and its joint follow from the result.
+  for (int i = 0; i < 2; ++i) {
+    const PREDICTION_MODE m =
+        is_compound ? (i == 0 ? compound_ref0_mode(mbmi->mode)
+                              : compound_ref1_mode(mbmi->mode))
+                    : (i == 0 ? mbmi->mode : NEARESTMV);
+    if (m == NEWMV) {
+      const int dr = mbmi->mv[i].as_mv.row - ref_mv[i].as_mv.row;
+      const int dc = mbmi->mv[i].as_mv.col - ref_mv[i].as_mv.col;
+      mbmi->insp_mvd[i][0] = (int16_t)dr;
+      mbmi->insp_mvd[i][1] = (int16_t)dc;
+      mbmi->insp_mv_joint[i] = (int8_t)((dr != 0) * 2 + (dc != 0));
+    } else {
+      mbmi->insp_mvd[i][0] = mbmi->insp_mvd[i][1] = -32768;
+      mbmi->insp_mv_joint[i] = -1;
+    }
+  }
+#endif
+
   mbmi->use_wedge_interintra = 0;
   if (cm->seq_params->enable_interintra_compound && !mbmi->skip_mode &&
       is_interintra_allowed(mbmi)) {
