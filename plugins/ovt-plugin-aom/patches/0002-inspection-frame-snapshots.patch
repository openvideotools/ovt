  av1/decoder/decoder.c     |  6 +++++
  av1/decoder/decoder.h     |  3 +++
  av1/decoder/inspection.c  |  2 ++
  av1/decoder/inspection.h  | 28 +++++++++++++++++++++++
  5 files changed, 97 insertions(+)

diff --git a/av1/decoder/decodeframe.c b/av1/decoder/decodeframe.c
index cbf5e91..d1018a2 100644
--- a/av1/decoder/decodeframe.c
+++ b/av1/decoder/decodeframe.c
@@ -5273,6 +5273,56 @@ static inline void setup_frame_info(AV1Decoder *pbi) {
   }
 }
 
+#if CONFIG_INSPECTION
+// Copies the current frame buffer into snapshot @stage when an inspection
+// callback is set; a no-op otherwise.
+static void inspection_snapshot(AV1Decoder *pbi, int stage) {
+  if (pbi->inspect_cb == NULL) return;
+  const AV1_COMMON *const cm = &pbi->common;
+  const YV12_BUFFER_CONFIG *const src = &cm->cur_frame->buf;
+  const int num_planes = av1_num_planes(cm);
+  const int hbd = (src->flags & YV12_FLAG_HIGHBITDEPTH) != 0;
+  const int bps = hbd ? 2 : 1;
+  for (int p = 0; p < 3; ++p) {
+    insp_plane *const dst = &pbi->insp_snapshots[stage][p];
+    if (p >= num_planes) {
+      dst->width = dst->height = 0;
+      continue;
+    }
+    const int is_uv = p > 0;
+    const int w = src->crop_widths[is_uv];
+    const int h = src->crop_heights[is_uv];
+    const size_t row_bytes = (size_t)w * bps;
+    const size_t size = row_bytes * h;
+    if (dst->capacity < size) {
+      aom_free(dst->buf);
+      dst->buf = (uint8_t *)aom_malloc(size);
+      dst->capacity = dst->buf != NULL ? size : 0;
+      if (dst->buf == NULL) {
+        aom_internal_error(cm->error, AOM_CODEC_MEM_ERROR,
+                           "Failed to allocate an inspection snapshot");
+      }
+    }
+    const uint8_t *s =
+        hbd ? (const uint8_t *)CONVERT_TO_SHORTPTR(src->buffers[p])
+            : src->buffers[p];
+    const size_t src_stride = (size_t)src->strides[is_uv] * bps;
+    for (int y = 0; y < h; ++y) {
+      memcpy(dst->buf + y * row_bytes, s + y * src_stride, row_bytes);
+    }
+    dst->width = w;
+    dst->height = h;
+    dst->stride = (int)row_bytes;
+    dst->bytes_per_sample = bps;
+  }
+}
+#define INSPECTION_SNAPSHOT(pbi, stage) inspection_snapshot(pbi, stage)
+#else
+#define INSPECTION_SNAPSHOT(pbi, stage) \
+  do {                                  \
+  } while (0)
+#endif
+
 void av1_decode_tg_tiles_and_wrapup(AV1Decoder *pbi, const uint8_t *data,
                                     const uint8_t *data_end,
                                     const uint8_t **p_data_end, int start_tile,
@@ -5309,12 +5359,14 @@ void av1_decode_tg_tiles_and_wrapup(AV1Decoder *pbi, const uint8_t *data,
                          pbi->num_workers, 1);
   av1_alloc_cdef_sync(cm, &pbi->cdef_sync, pbi->num_workers);
 
+  INSPECTION_SNAPSHOT(pbi, INSP_SNAPSHOT_PRE_DEBLOCK);
   if (!cm->features.allow_intrabc && !tiles->single_tile_decoding) {
     if (cm->lf.filter_level[0] || cm->lf.filter_level[1]) {
       av1_loop_filter_frame_mt(&cm->cur_frame->buf, cm, &pbi->dcb.xd, 0,
                                num_planes, 0, pbi->tile_workers,
                                pbi->num_workers, &pbi->lf_row_sync, 0);
     }
+    INSPECTION_SNAPSHOT(pbi, INSP_SNAPSHOT_PRE_CDEF);
 
     const int do_cdef =
         !pbi->skip_loop_filter && !cm->features.coded_lossless &&
@@ -5347,6 +5399,7 @@ void av1_decode_tg_tiles_and_wrapup(AV1Decoder *pbi, const uint8_t *data,
       }
 
       superres_post_decode(pbi);
+      INSPECTION_SNAPSHOT(pbi, INSP_SNAPSHOT_PRE_LR);
 
       if (do_loop_restoration) {
         av1_loop_restoration_save_boundary_lines(&pbi->common.cur_frame->buf,
@@ -5363,6 +5416,7 @@ void av1_decode_tg_tiles_and_wrapup(AV1Decoder *pbi, const uint8_t *data,
         }
       }
     } else {
+      INSPECTION_SNAPSHOT(pbi, INSP_SNAPSHOT_PRE_LR);
       // In no cdef and no superres case. Provide an optimized version of
       // loop_restoration_filter.
       if (do_loop_restoration) {
@@ -5378,6 +5432,10 @@ void av1_decode_tg_tiles_and_wrapup(AV1Decoder *pbi, const uint8_t *data,
         }
       }
     }
+  } else {
+    // IntraBC frames and single-tile decoding skip the in-loop filters.
+    INSPECTION_SNAPSHOT(pbi, INSP_SNAPSHOT_PRE_CDEF);
+    INSPECTION_SNAPSHOT(pbi, INSP_SNAPSHOT_PRE_LR);
   }
 
   if (!pbi->dcb.corrupted) {
diff --git a/av1/decoder/decoder.c b/av1/decoder/decoder.c
index 0ae0b86..e6d5289 100644
--- a/av1/decoder/decoder.c
+++ b/av1/decoder/decoder.c
@@ -180,6 +180,12 @@ void av1_decoder_remove(AV1Decoder *pbi) {
   // Free the tile list output buffer.
   aom_free_frame_buffer(&pbi->tile_list_outbuf);
 
+#if CONFIG_INSPECTION
+  for (int k = 0; k < INSP_SNAPSHOTS; k++) {
+    for (int p = 0; p < 3; p++) aom_free(pbi->insp_snapshots[k][p].buf);
+  }
+#endif
+
   aom_get_worker_interface()->end(&pbi->lf_worker);
   aom_free(pbi->lf_worker.data1);
 
diff --git a/av1/decoder/decoder.h b/av1/decoder/decoder.h
index d6610cd..36ec38f 100644
--- a/av1/decoder/decoder.h
