+  insp_plane insp_snapshots[INSP_SNAPSHOTS][3];
 #endif
   int operating_point;
   int current_operating_point;
diff --git a/av1/decoder/inspection.c b/av1/decoder/inspection.c
index 9585cd9..e28d1fd 100644
--- a/av1/decoder/inspection.c
+++ b/av1/decoder/inspection.c
@@ -206,6 +206,8 @@ int ifd_inspect(insp_frame_data *fd, void *decoder, int skip_not_transform) {
   fd->accounting = &pbi->accounting;
 #endif
   ifd_inspect_frame_filters(fd, cm);
