+    fd->snapshots[k] = pbi->insp_snapshots[k];
   int i, j;
   for (i = 0; i < MAX_SEGMENTS; i++) {
     for (j = 0; j < 2; j++) {
diff --git a/av1/decoder/inspection.h b/av1/decoder/inspection.h
index 68e374d..617d787 100644
--- a/av1/decoder/inspection.h
+++ b/av1/decoder/inspection.h
@@ -92,6 +92,31 @@ struct insp_mi_data {
 
 #define INSPECTION_MVD_NONE (-32768)
 
+// Frame snapshots (INSPECTION_FRAME_SNAPSHOTS): copies of the frame buffer
+// taken while the inspection callback is set, before each in-loop filter.
+#define INSPECTION_FRAME_SNAPSHOTS 1
+
+enum {
+  INSP_SNAPSHOT_PRE_DEBLOCK,    // reconstruction before the deblocking filter
+  INSP_SNAPSHOT_PRE_CDEF,       // after deblocking, before CDEF
+  INSP_SNAPSHOT_PRE_LR,         // after CDEF and super-resolution, before LR
+  INSP_SNAPSHOTS
+};
+
+typedef struct insp_plane insp_plane;
+
+// One plane of a snapshot: height rows of width samples, stride bytes apart,
+// bytes_per_sample 1 (8-bit buffers) or 2 (uint16, native endianness).
+// Width 0: the plane is absent (monochrome chroma, or no snapshot taken).
+struct insp_plane {
+  uint8_t *buf;
+  size_t capacity;
+  int width;
+  int height;
+  int stride;
+  int bytes_per_sample;
+};
+
 typedef struct insp_lr_unit insp_lr_unit;
 
 // One loop restoration unit: RestorationUnitInfo of the frame.
@@ -149,6 +174,9 @@ struct insp_frame_data {
   int lr_vert_units[3];
   insp_lr_unit *lr_units[3];
   int lr_units_alloc[3];
+  // Snapshots of the frame (INSPECTION_FRAME_SNAPSHOTS), owned by the
+  // decoder and valid until the next frame is decoded.
+  const insp_plane *snapshots[INSP_SNAPSHOTS];  // [stage] -> 3 planes
 };
 
 void ifd_init(insp_frame_data *fd, int frame_width, int frame_height);
