# HM plugin tests (WI-4.105): the relaxations of plugins/ovt-plugin-de265/tests/.clang-tidy.
InheritParentConfig: true
Checks: >
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -bugprone-unchecked-optional-access
