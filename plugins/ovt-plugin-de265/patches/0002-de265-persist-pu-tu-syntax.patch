index 073dbc2..05d8e94 100644
--- a/libde265/de265_internals.h
+++ b/libde265/de265_internals.h
@@ -18,7 +18,8 @@
  * along with libde265.  If not, see <http://www.gnu.org/licenses/>.
  */
 
-/* de265_internals.h -- read-only access to per-picture metadata (OVT patch 0001).
+/* de265_internals.h -- read-only access to per-picture metadata (OVT patch 0001) and to
+ * the PU/TU syntax and bit positions it can keep (OVT patch 0002).
  *
  * Built only with the CMake option DE265_INTERNALS=ON. Every function reads the metadata
  * that the decoder already keeps for a decoded picture (the image returned by
@@ -172,6 +173,97 @@ LIBDE265_API int      de265_internals_get_picture_poc(const struct de265_image*)
 LIBDE265_API void     de265_internals_get_sps_sizes(const struct de265_image*, int* CtbLog2SizeY, int* MinCbLog2SizeY,
                                                     int* MinTbLog2SizeY, int* PicWidthInCtbsY, int* PicHeightInCtbsY);
 
+/* --- PU/TU syntax and bit positions (OVT patch 0002) ---
+ *
+ * With DE265_INTERNALS_PARAM_KEEP_SYNTAX set on a decoder context, every picture that starts
+ * decoding afterwards keeps the prediction-unit and transform-unit syntax elements that the
+ * decoder otherwise drops after use, and the entropy-coded size of every coding unit and CTB.
+ * Off by default: then nothing is allocated, de265_internals_has_syntax() returns 0 and the
+ * getters below return zero-filled values.
+ */
+enum de265_internals_param {
+  DE265_INTERNALS_PARAM_KEEP_SYNTAX = 0   /* keep PU/TU syntax and bit positions (default 0) */
+};
+
+/* Sets a boolean internals parameter (enum de265_internals_param) for the pictures that start
+   decoding afterwards. */
+LIBDE265_API void     de265_internals_set_parameter_bool(de265_decoder_context*, enum de265_internals_param, int value);
+/* 1 when the picture was decoded with KEEP_SYNTAX, 0 otherwise. */
+LIBDE265_API int      de265_internals_has_syntax(const struct de265_image*);
+
+#define DE265_INTERNALS_PU_NONE  0     /* no prediction syntax at this 4x4 (not decoded, or PCM) */
+#define DE265_INTERNALS_PU_INTER 1     /* prediction_unit() of an inter or skipped CU (H.265 7.3.8.6) */
+#define DE265_INTERNALS_PU_INTRA 2     /* intra prediction block of coding_unit() (H.265 7.3.8.5) */
+
+/* The syntax of the prediction block covering a 4x4 unit, as signalled. Fields that do not
+   apply to the block's kind, or that were not signalled, hold 255 (unsigned) or -1 (ref_idx);
+   mvd_x/mvd_y hold 0 then. */
+typedef struct de265_internals_pu_syntax {
+  uint8_t kind;                       /* DE265_INTERNALS_PU_* */
+  /* inter */
+  uint8_t merge_flag;                 /* 1 also when inferred from cu_skip_flag */
+  uint8_t merge_idx;                  /* when merge_flag is 1 */
+  uint8_t inter_pred_idc;             /* when merge_flag is 0: 0 PRED_L0, 1 PRED_L1, 2 PRED_BI (PRED_L0 is
+                                         inferred in P slices) */
+  int8_t  ref_idx[2];                 /* ref_idx_l0/l1 for the lists inter_pred_idc uses (0 when inferred
+                                         because the list has one active entry) */
+  uint8_t mvp_lX_flag[2];             /* mvp_l0_flag / mvp_l1_flag for those lists */
+  int16_t mvd_x[2];                   /* MvdLX of mvd_coding() in quarter samples, for those lists */
+  int16_t mvd_y[2];
+  uint8_t mvd_l1_zero;                /* 1: PRED_BI with mvd_l1_zero_flag, MvdL1 = 0 was not coded */
+  /* intra */
+  uint8_t prev_intra_luma_pred_flag;
+  uint8_t mpm_idx;                    /* when prev_intra_luma_pred_flag is 1 */
+  uint8_t rem_intra_luma_pred_mode;   /* when prev_intra_luma_pred_flag is 0 */
+  uint8_t intra_chroma_pred_mode;     /* 0..4 as signalled; 255 in 4:0:0 */
+} de265_internals_pu_syntax;
+
+/* unit = 4x4, the layout of de265_internals_get_PB_info_layout() */
+LIBDE265_API void     de265_internals_get_PU_syntax(const struct de265_image*, int x4, int y4, de265_internals_pu_syntax* out);
+
+/* The syntax of the transform unit (leaf of transform_tree(), H.265 7.3.8.8 and 7.3.8.10)
+   covering a 4x4 unit. Per-component arrays are indexed Y, Cb, Cr. In 4:2:0 the chroma
+   blocks of four 4x4 luma TUs are coded in the fourth one (blkIdx 3), so their chroma residual
+   fields are filled there only; cbf[1..2] of blkIdx 0..2 hold the value inherited from the 8x8
+   parent. Elements not signalled in this TU hold 255. */
+typedef struct de265_internals_tu_syntax {
+  uint8_t  coded;                     /* 1 when transform_unit() was read for the TU covering this 4x4 */
+  uint8_t  trafoDepth;                /* depth in the transform tree (rqt depth) */
+  uint8_t  log2TrafoSize;             /* luma transform size */
+  uint8_t  cbf[3];                    /* cbf_luma, cbf_cb, cbf_cr of this TU, inferred values included;
+                                         4:2:2 chroma: bit 0 first, bit 1 second chroma block */
+  uint8_t  transform_skip_flag[3];
+  uint8_t  explicit_rdpcm_flag[3];
+  uint8_t  explicit_rdpcm_dir_flag[3];
+  uint8_t  last_sig_coeff_x[3];       /* LastSignificantCoeffX/Y (H.265 7.4.9.11, after the swap for
+                                         vertical scan) of the component's first block coded here */
+  uint8_t  last_sig_coeff_y[3];
+  uint16_t nnz[3];                    /* non-zero coefficients coded in this TU per component; 0 when none */
+  uint8_t  cu_qp_delta_abs;           /* when coded in this TU (the first TU with a cbf of its
+                                         quantization group) */
+  uint8_t  cu_qp_delta_sign_flag;     /* 0 when cu_qp_delta_abs is 0 */
+  uint8_t  cu_chroma_qp_offset_flag;
+  uint8_t  cu_chroma_qp_offset_idx;   /* 0 when cu_chroma_qp_offset_flag is 0 or the list has one entry */
