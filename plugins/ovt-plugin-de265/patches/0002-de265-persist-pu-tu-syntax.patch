+/* de265_internals_syntax.h -- the decoder's calls into the syntax store of OVT patch 0002.
+ * Internal (not installed); every caller is under #ifdef DE265_INTERNALS. Each store call
+ * returns at once when the picture keeps no syntax (KEEP_SYNTAX off), so pictures decoded
+ * without it pay one pointer test per call site. C linkage keeps the library's symbols to
+ * de265_internals_*. Coordinates are luma samples. */
+
+#ifndef DE265_INTERNALS_SYNTAX_H
+#define DE265_INTERNALS_SYNTAX_H
+
+#include <stdint.h>
+
+#include "cabac.h"
+#include "de265_internals.h"
+
+struct de265_image;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A new picture starts decoding (after clear_metadata()): allocate or clear its syntax store
+   when the decoder context keeps syntax, free it otherwise. */
+void de265_internals_syntax_picture_start(struct de265_image* img);
+/* The picture's buffers are released (de265_image::release()). */
+void de265_internals_syntax_free(struct de265_image* img);
+/* 1 when img keeps syntax. */
+int  de265_internals_syntax_on(const struct de265_image* img);
+
+/* Store the syntax of the prediction block (x,y,w,h) / the transform unit at (x,y). */
+void de265_internals_store_pu(struct de265_image* img, int x, int y, int w, int h,
+                              const de265_internals_pu_syntax* pu);
+void de265_internals_store_tu(struct de265_image* img, int x, int y, int log2TrafoSize,
+                              const de265_internals_tu_syntax* tu);
+/* Store the size of the CU (x,y,log2CbSize) / of the CTB containing luma sample (x,y). */
+void de265_internals_store_cu_bits(struct de265_image* img, int x, int y, int log2CbSize, uint32_t bits_x8);
+void de265_internals_store_ctb_bits(struct de265_image* img, int x, int y, uint32_t bits_x8);
+
+/* Position of the CABAC decoder in 1/8 bits from its bitstream_start: 64 x the bytes read,
+   less 8 x the bits buffered but not yet used, less the fractional bits still held in the
+   9-bit range register (8 x log2(range/256), from a table). Just after init_CABAC_decoder_2()
+   at byte p it is exactly 64 x p, so differences across a re-initialisation stay exact. */
+int64_t de265_internals_cabac_tell_x8(const CABAC_decoder* decoder);
+/* 64 x the byte offset of bitstream_curr from bitstream_start: the end of a substream once its
+   end_of_subset_one_bit has been decoded. */
+int64_t de265_internals_cabac_byte_pos_x8(const CABAC_decoder* decoder);
+/* 8 x the bit offset, from bitstream_start, of the rbsp_stop_one_bit before bitstream_end (the
+   last non-zero byte; cabac_zero_words are skipped): the end of slice_segment_data(). */
+int64_t de265_internals_cabac_data_end_x8(const CABAC_decoder* decoder);
+
+#ifdef __cplusplus
+}
+#endif
