+
+
+/* --- Plane snapshots (OVT patch 0003) ---
+   Plain arrays and free functions only, so that the library's external symbols stay the
+   upstream ones plus de265_internals_* (no template instantiations, no member functions). */
+
+struct de265_internals_snapshot_component
+{
+  int width, height, bytes;      /* samples; bytes per pixel sample */
+  uint8_t* pre_deblock;          /* width*height*bytes each */
+  uint8_t* pre_sao;
+  uint8_t* prediction;
+  int32_t* coefficients;         /* width*height */
+  uint8_t* predicted;            /* one flag per 4x4 block: prediction captured */
+};
+
+/* The snapshots of one picture; de265_image::internals_snap points here. */
+struct de265_internals_snapshots
+{
+  de265_internals_snapshot_component comp[3];
+  int num_components;
+  int have_pre_deblock, have_pre_sao;
+  uint64_t bytes;
+};
+
+typedef de265_internals_snapshot_component snap_comp;
+
+namespace {
+
+void delete_snapshots(de265_internals_snapshots* snap)
+{
+  for (int cIdx = 0; cIdx < 3; cIdx++) {
+    snap_comp& c = snap->comp[cIdx];
+    delete[] c.pre_deblock;
+    delete[] c.pre_sao;
+    delete[] c.prediction;
+    delete[] c.coefficients;
+    delete[] c.predicted;
+  }
+  delete snap;
+}
+
+void free_snapshots(de265_image* img)
+{
+  de265_internals_snapshots* snap = img->internals_snap;
+  if (snap == NULL) return;
+  if (img->decctx != NULL) img->decctx->internals_snapshot_bytes -= snap->bytes;
+  img->internals_snap = NULL;
+  delete_snapshots(snap);
+}
+
+int blocks_wide(const snap_comp& c) { return (c.width + 3) / 4; }
+
+void copy_pixels(const de265_image* img, int cIdx, uint8_t* dst)
+{
+  const int bytes  = img->get_bytes_per_pixel(cIdx);
+  const size_t row = (size_t)img->get_width(cIdx) * bytes;
+  const size_t stride = (size_t)img->get_image_stride(cIdx) * bytes;
+  const uint8_t* src = img->get_image_plane(cIdx);
+  for (int y = 0; y < img->get_height(cIdx); y++) {
+    memcpy(dst + y * row, src + y * stride, row);
+  }
+}
+
+/* True when the n x n block at (x,y) lies inside the component. */
+bool inside_component(const snap_comp& c, int x, int y, int n)
+{
+  return x >= 0 && y >= 0 && n > 0 && x + n <= c.width && y + n <= c.height;
+}
+
+}  // namespace
+
+
+void de265_internals_set_plane_snapshots(de265_decoder_context* ctx, int enable)
+{
+  if (ctx != NULL) ((decoder_context*)ctx)->internals_snapshots = (enable != 0);
+}
+
+const void* de265_internals_get_snapshot_plane(const struct de265_image* img, int snapshot, int cIdx,
+                                               int* width, int* height, int* stride_bytes)
+{
+  if (width) *width = 0;
+  if (height) *height = 0;
+  if (stride_bytes) *stride_bytes = 0;
+  if (img == NULL || img->internals_snap == NULL) return NULL;
+  const de265_internals_snapshots* snap = img->internals_snap;
+  if (cIdx < 0 || cIdx >= snap->num_components) return NULL;
+  const snap_comp& c = snap->comp[cIdx];
+
+  const void* data = NULL;
+  int sample_bytes = c.bytes;
+  switch (snapshot) {
+  case DE265_INTERNALS_SNAPSHOT_PRE_DEBLOCK:  if (snap->have_pre_deblock) data = c.pre_deblock; break;
+  case DE265_INTERNALS_SNAPSHOT_PRE_SAO:      if (snap->have_pre_sao) data = c.pre_sao; break;
+  case DE265_INTERNALS_SNAPSHOT_PREDICTION:   if (snap->have_pre_deblock) data = c.prediction; break;
+  case DE265_INTERNALS_SNAPSHOT_COEFFICIENTS:
+    if (snap->have_pre_deblock) data = c.coefficients;
+    sample_bytes = (int)sizeof(int32_t);
+    break;
+  default: break;
+  }
+  if (data == NULL) return NULL;
+  if (width) *width = c.width;
+  if (height) *height = c.height;
+  if (stride_bytes) *stride_bytes = c.width * sample_bytes;
+  return data;
+}
+
+void de265_internals_release_snapshots(const struct de265_image* img)
+{
+  if (img != NULL) free_snapshots(const_cast<de265_image*>(img));
+}
+
+uint64_t de265_internals_get_snapshot_peak_bytes(const de265_decoder_context* ctx)
+{
+  return ctx != NULL ? ((const decoder_context*)ctx)->internals_snapshot_peak_bytes : 0;
+}
+
+
+void de265_internals_hook_picture_start(struct de265_image* img)
+{
+  free_snapshots(img);
+  decoder_context* ctx = img->decctx;
+  if (ctx == NULL || !ctx->internals_snapshots || !img->has_sps()) return;
+
+  de265_internals_snapshots* snap = new (std::nothrow) de265_internals_snapshots;
+  if (snap == NULL) return;   /* no snapshots for this picture; decoding goes on */
+  memset(snap, 0, sizeof(*snap));
+  snap->num_components = (img->get_chroma_format() == de265_chroma_mono) ? 1 : 3;
+  bool ok = true;
+  for (int cIdx = 0; cIdx < snap->num_components; cIdx++) {
+    snap_comp& c = snap->comp[cIdx];
+    c.width  = img->get_width(cIdx);
+    c.height = img->get_height(cIdx);
+    c.bytes  = img->get_bytes_per_pixel(cIdx);
+    const size_t samples = (size_t)c.width * c.height;
+    const size_t blocks  = (size_t)blocks_wide(c) * ((c.height + 3) / 4);
+    c.pre_deblock  = new (std::nothrow) uint8_t[samples * c.bytes];
+    c.pre_sao      = new (std::nothrow) uint8_t[samples * c.bytes];
+    c.prediction   = new (std::nothrow) uint8_t[samples * c.bytes];
+    c.coefficients = new (std::nothrow) int32_t[samples]();
+    c.predicted    = new (std::nothrow) uint8_t[blocks]();
+    ok = ok && c.pre_deblock && c.pre_sao && c.prediction && c.coefficients && c.predicted;
+    snap->bytes += samples * (3 * c.bytes + sizeof(int32_t)) + blocks;
+  }
+  if (!ok) {
+    delete_snapshots(snap);
+    return;
+  }
+  img->internals_snap = snap;
+  ctx->internals_snapshot_bytes += snap->bytes;
+  if (ctx->internals_snapshot_bytes > ctx->internals_snapshot_peak_bytes) {
+    ctx->internals_snapshot_peak_bytes = ctx->internals_snapshot_bytes;
+  }
+}
+
+void de265_internals_hook_free(struct de265_image* img)
+{
+  free_snapshots(img);
+}
+
+void de265_internals_hook_tb_prediction(struct de265_image* img, int cIdx, int xT, int yT, int nT,
+                                        const void* pred, int pred_stride)
+{
+  de265_internals_snapshots* snap = img->internals_snap;
+  if (snap == NULL || cIdx < 0 || cIdx >= snap->num_components) return;
+  snap_comp& c = snap->comp[cIdx];
+  if (!inside_component(c, xT, yT, nT)) return;
+
+  const size_t row = (size_t)nT * c.bytes;
+  const uint8_t* src = (const uint8_t*)pred;
+  for (int y = 0; y < nT; y++) {
+    memcpy(c.prediction + ((size_t)(yT + y) * c.width + xT) * c.bytes,
+           src + (size_t)y * pred_stride * c.bytes, row);
+  }
+  for (int by = yT / 4; by < (yT + nT) / 4; by++) {
+    memset(c.predicted + (size_t)by * blocks_wide(c) + xT / 4, 1, nT / 4);
+  }
+}
+
+void de265_internals_hook_tb_coefficients(struct de265_image* img, int cIdx, int xT, int yT, int nT,
+                                          const int16_t* coeff)
+{
+  de265_internals_snapshots* snap = img->internals_snap;
+  if (snap == NULL || cIdx < 0 || cIdx >= snap->num_components) return;
+  snap_comp& c = snap->comp[cIdx];
+  if (!inside_component(c, xT, yT, nT)) return;
+
+  for (int v = 0; v < nT; v++) {
+    int32_t* dst = c.coefficients + (size_t)(yT + v) * c.width + xT;
+    for (int u = 0; u < nT; u++) {
+      dst[u] = coeff[u + v * nT];
+    }
+  }
+}
+
+void de265_internals_hook_pre_deblock(struct de265_image* img)
+{
+  de265_internals_snapshots* snap = img->internals_snap;
+  if (snap == NULL) return;
+
+  const seq_parameter_set& sps = img->get_sps();
+  for (int cIdx = 0; cIdx < snap->num_components; cIdx++) {
+    snap_comp& c = snap->comp[cIdx];
+    copy_pixels(img, cIdx, c.pre_deblock);
+
+    /* Complete the prediction per 4x4 block: PCM and transquant-bypass coding units have
+       prediction 0 by convention; a block without a residual (cbf 0, skip) never reached
+       scale_coefficients(), so its prediction is its reconstruction. */
+    const int sub_w = cIdx ? sps.SubWidthC : 1;
+    const int sub_h = cIdx ? sps.SubHeightC : 1;
+    for (int by = 0; by < (c.height + 3) / 4; by++) {
+      for (int bx = 0; bx < blocks_wide(c); bx++) {
+        const int x = bx * 4;
+        const int y = by * 4;
+        const bool lossless = img->get_pcm_flag(x * sub_w, y * sub_h) ||
+                              img->get_cu_transquant_bypass(x * sub_w, y * sub_h);
+        if (!lossless && c.predicted[(size_t)by * blocks_wide(c) + bx]) continue;
+        const int w = (c.width - x < 4) ? c.width - x : 4;
+        const int h = (c.height - y < 4) ? c.height - y : 4;
+        for (int r = 0; r < h; r++) {
+          const size_t at = ((size_t)(y + r) * c.width + x) * c.bytes;
+          if (lossless) memset(c.prediction + at, 0, (size_t)w * c.bytes);
+          else          memcpy(c.prediction + at, c.pre_deblock + at, (size_t)w * c.bytes);
+        }
+      }
+    }
+  }
+  snap->have_pre_deblock = 1;
+}
+
+void de265_internals_hook_pre_sao(struct de265_image* img)
+{
+  de265_internals_snapshots* snap = img->internals_snap;
+  if (snap == NULL || !snap->have_pre_deblock) return;
+  for (int cIdx = 0; cIdx < snap->num_components; cIdx++) {
+    copy_pixels(img, cIdx, snap->comp[cIdx].pre_sao);
+  }
+  snap->have_pre_sao = 1;
+}
