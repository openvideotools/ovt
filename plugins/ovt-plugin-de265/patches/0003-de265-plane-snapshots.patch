-/* de265_internals.h -- read-only access to per-picture metadata (OVT patch 0001).
+/* de265_internals.h -- read-only access to per-picture metadata (OVT patch 0001) and
+ * plane snapshots (OVT patch 0003).
  *
  * Built only with the CMake option DE265_INTERNALS=ON. Every function reads the metadata
  * that the decoder already keeps for a decoded picture (the image returned by
@@ -167,6 +168,46 @@ LIBDE265_API int      de265_internals_get_picture_poc(const struct de265_image*)
 LIBDE265_API void     de265_internals_get_sps_sizes(const struct de265_image*, int* CtbLog2SizeY, int* MinCbLog2SizeY,
                                                     int* MinTbLog2SizeY, int* PicWidthInCtbsY, int* PicHeightInCtbsY);
 
+/* --- Plane snapshots (OVT patch 0003) ---
+ *
+ * With snapshots enabled on a decoder context, every picture decoded from then on keeps four
+ * extra planes per colour component, each covering the whole decoded picture
+ * (pic_width/height_in_luma_samples, chroma subsampled):
+ *
+ *   PRE_DEBLOCK   the reconstruction before the deblocking filter (pixels, like the picture),
+ *   PRE_SAO       the picture after deblocking, before SAO (pixels),
+ *   PREDICTION    the intra or inter prediction of every sample (pixels); by convention 0 for
+ *                 PCM and cu_transquant_bypass coding units,
+ *   COEFFICIENTS  int32 dequantised transform coefficients (scaled levels for transform-skip,
+ *                 the levels themselves for cu_transquant_bypass): coefficient (u,v) of the
+ *                 transform block at (x0,y0) sits at sample (x0+u, y0+v); zero elsewhere.
+ *
+ * The residual is PRE_DEBLOCK - PREDICTION for every sample (it is not stored twice).
+ * Pixel planes use the picture's sample size: one byte per sample at 8 bits, two bytes
+ * (native endian) above. Snapshots cost about (3 x pixel size + 4) bytes per sample of the
+ * picture, so a consumer releases them as soon as it has copied them out; they are freed with
+ * the picture otherwise. Disabled by default: with snapshots off nothing is allocated or copied.
+ */
+enum de265_internals_snapshot {
+  DE265_INTERNALS_SNAPSHOT_PRE_DEBLOCK  = 0,
+  DE265_INTERNALS_SNAPSHOT_PRE_SAO      = 1,
+  DE265_INTERNALS_SNAPSHOT_PREDICTION   = 2,
+  DE265_INTERNALS_SNAPSHOT_COEFFICIENTS = 3
+};
+
+/* Enables (1) or disables (0) snapshots for the pictures that start decoding afterwards. */
+LIBDE265_API void     de265_internals_set_plane_snapshots(de265_decoder_context*, int enable);
+/* The plane of one snapshot (enum de265_internals_snapshot) of colour component cIdx, or NULL
+   when the picture has none (snapshots off, released, out of memory, or not finished). Any
+   size pointer may be NULL. Valid until de265_internals_release_snapshots() or the release of
+   the picture. */
+LIBDE265_API const void* de265_internals_get_snapshot_plane(const struct de265_image*, int snapshot, int cIdx,
+                                                            int* width, int* height, int* stride_bytes);
+/* Frees the snapshots of a picture (it stays a valid picture). */
+LIBDE265_API void     de265_internals_release_snapshots(const struct de265_image*);
+/* The most snapshot memory, in bytes, that the context's pictures held at the same time. */
+LIBDE265_API uint64_t de265_internals_get_snapshot_peak_bytes(const de265_decoder_context*);
+
 #ifdef __cplusplus
 }
 #endif
