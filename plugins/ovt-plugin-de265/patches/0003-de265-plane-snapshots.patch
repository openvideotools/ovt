+/* de265_internals_hooks.h -- the decoder's calls into the plane snapshots of OVT patch 0003.
+ * Internal (not installed); every caller is under #ifdef DE265_INTERNALS. Each hook returns at
+ * once when the picture has no snapshots, so pictures decoded with snapshots off pay one
+ * pointer test per call site. C linkage keeps the library's symbols to de265_internals_*. */
+
+#ifndef DE265_INTERNALS_HOOKS_H
+#define DE265_INTERNALS_HOOKS_H
+
+#include <stdint.h>
+
+struct de265_image;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A new picture starts decoding (after clear_metadata()): allocate its snapshots when the
+   decoder context has them enabled. */
+void de265_internals_hook_picture_start(struct de265_image* img);
+/* The picture's buffers are released (de265_image::release()). */
+void de265_internals_hook_free(struct de265_image* img);
+/* scale_coefficients(), before the residual is added: the prediction of the nT x nT transform
+   block at (xT,yT) of component cIdx (component sample coordinates), pred_stride in samples. */
+void de265_internals_hook_tb_prediction(struct de265_image* img, int cIdx, int xT, int yT, int nT,
+                                        const void* pred, int pred_stride);
+/* scale_coefficients(), after inverse quantisation: the nT x nT coefficient block. */
+void de265_internals_hook_tb_coefficients(struct de265_image* img, int cIdx, int xT, int yT, int nT,
+                                          const int16_t* coeff);
+/* Every slice segment is decoded, the in-loop filters have not run. */
+void de265_internals_hook_pre_deblock(struct de265_image* img);
+/* Deblocking has finished, SAO has not started. */
+void de265_internals_hook_pre_sao(struct de265_image* img);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
