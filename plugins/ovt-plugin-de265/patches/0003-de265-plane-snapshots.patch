@@ -343,3 +349,243 @@ void de265_internals_get_sps_sizes(const struct de265_image* img, int* CtbLog2Si
   if (PicWidthInCtbsY)  *PicWidthInCtbsY  = ok ? sps->PicWidthInCtbsY  : 0;
