+ * along with libde265.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/* Read-only internals API (OVT patch 0001). Reads the metadata arrays of a decoded
+   de265_image; changes nothing. The public functions take unit coordinates; the
+   de265_image accessors take luma sample coordinates, so every function converts. */
+
+#include "de265_internals.h"
+#include "image.h"
+#include "slice.h"
+#include "sps.h"
+
+#include <string.h>
+
+
+struct de265_internals_access
+{
+  static const MetaDataArray<CTB_info>&    ctb(const de265_image* img) { return img->ctb_info; }
+  static const MetaDataArray<CB_ref_info>& cb (const de265_image* img) { return img->cb_info; }
+  static const MetaDataArray<PBMotion>&    pb (const de265_image* img) { return img->pb_info; }
+  static const MetaDataArray<uint8_t>&     ipm(const de265_image* img) { return img->intraPredMode; }
+  static const MetaDataArray<uint8_t>&     tu (const de265_image* img) { return img->tu_info; }
+  static const MetaDataArray<uint8_t>&     deblk(const de265_image* img) { return img->deblk_info; }
+};
+
+typedef de265_internals_access ia;
+
+
+namespace {
+
+template <class T>
+de265_internals_layout layout_of(const MetaDataArray<T>& a)
+{
+  de265_internals_layout l;
+  l.log2_unit_size  = a.log2unitSize;
+  l.width_in_units  = a.width_in_units;
+  l.height_in_units = a.height_in_units;
+  return l;
+}
+
+/* The 4x4 view of an array whose units are 4x4 or larger. */
+template <class T>
+de265_internals_layout layout_4x4(const MetaDataArray<T>& a)
+{
+  de265_internals_layout l;
+  l.log2_unit_size  = 2;
+  l.width_in_units  = a.width_in_units  << (a.log2unitSize - 2);
+  l.height_in_units = a.height_in_units << (a.log2unitSize - 2);
+  return l;
+}
+
+de265_internals_layout empty_layout()
+{
+  de265_internals_layout l;
+  l.log2_unit_size = l.width_in_units = l.height_in_units = 0;
+  return l;
+}
+
+bool inside(const de265_internals_layout& l, int x, int y)
+{
+  return x >= 0 && y >= 0 && x < l.width_in_units && y < l.height_in_units;
+}
+
+bool has_metadata(const de265_image* img)
+{
+  return img != NULL && img->has_sps() && ia::cb(img).data != NULL;
+}
+
+/* The slice header of the CTB containing luma sample (x,y), or NULL. */
+const slice_segment_header* slice_at(const de265_image* img, int x, int y)
+{
+  const MetaDataArray<CTB_info>& ctb = ia::ctb(img);
+  return img->get_SliceHeaderCtb(x >> ctb.log2unitSize, y >> ctb.log2unitSize);
+}
+
+}  // namespace
+
+
+/* --- CTB --- */
+
+de265_internals_layout de265_internals_get_CTB_info_layout(const struct de265_image* img)
+{
+  return has_metadata(img) ? layout_of(ia::ctb(img)) : empty_layout();
+}
+
+uint16_t de265_internals_get_CTB_slice_header_index(const struct de265_image* img, int ctb_x, int ctb_y)
+{
+  if (!inside(de265_internals_get_CTB_info_layout(img), ctb_x, ctb_y)) return 0;
+  return (uint16_t)img->get_SliceHeaderIndexCtb(ctb_x, ctb_y);
+}
+
+int de265_internals_get_CTB_slice_addr_rs(const struct de265_image* img, int ctb_x, int ctb_y)
+{
+  if (!inside(de265_internals_get_CTB_info_layout(img), ctb_x, ctb_y)) return 0;
+  return img->get_SliceAddrRS(ctb_x, ctb_y);
+}
+
+void de265_internals_get_CTB_sao(const struct de265_image* img, int ctb_x, int ctb_y, de265_internals_sao* out)
+{
+  if (out == NULL) return;
+  memset(out, 0, sizeof(*out));
+  if (!inside(de265_internals_get_CTB_info_layout(img), ctb_x, ctb_y)) return;
+
+  const sao_info* sao = img->get_sao_info(ctb_x, ctb_y);
+  for (int c = 0; c < 3; c++) {
+    out->SaoTypeIdx[c]      = (sao->SaoTypeIdx >> (2*c)) & 0x3;
+    out->SaoEoClass[c]      = (sao->SaoEoClass >> (2*c)) & 0x3;
+    out->SaoBandPosition[c] = sao->sao_band_position[c];
+    for (int i = 0; i < 4; i++) {
+      out->SaoOffsetVal[c][i] = sao->saoOffsetVal[c][i];
+    }
+  }
+}
+
+uint8_t de265_internals_get_CTB_flags(const struct de265_image* img, int ctb_x, int ctb_y)
+{
+  if (!inside(de265_internals_get_CTB_info_layout(img), ctb_x, ctb_y)) return 0;
+
+  uint8_t flags = 0;
+  if (img->get_CTB_has_pcm_or_cu_transquant_bypass(ctb_x, ctb_y)) {
+    flags |= DE265_INTERNALS_CTB_FLAG_PCM_OR_TRANSQUANT_BYPASS;
+  }
+  const slice_segment_header* shdr = img->get_SliceHeaderCtb(ctb_x, ctb_y);
+  if (shdr != NULL && shdr->slice_deblocking_filter_disabled_flag) {
+    flags |= DE265_INTERNALS_CTB_FLAG_DEBLOCKING_DISABLED;
+  }
+  return flags;
+}
+
+
+/* --- CB --- */
+
+de265_internals_layout de265_internals_get_CB_info_layout(const struct de265_image* img)
+{
+  return has_metadata(img) ? layout_of(ia::cb(img)) : empty_layout();
+}
+
+void de265_internals_get_CB_info(const struct de265_image* img, int unit_x, int unit_y, de265_internals_cb* out)
+{
+  if (out == NULL) return;
+  memset(out, 0, sizeof(*out));
+  const de265_internals_layout l = de265_internals_get_CB_info_layout(img);
+  if (!inside(l, unit_x, unit_y)) return;
+
+  const int log2MinCb = l.log2_unit_size;
+  const int x = unit_x << log2MinCb;
+  const int y = unit_y << log2MinCb;
+
+  // libde265 stores log2CbSize and PartMode only at the CB's top-left unit (zero elsewhere).
+  // CBs are aligned to their size, so the CB covering (x,y) is the smallest aligned square
+  // whose top-left unit records exactly that size.
+  const int log2Ctb = img->get_sps().Log2CtbSizeY;
+  for (int log2Size = log2MinCb; log2Size <= log2Ctb; log2Size++) {
+    const int x0 = (x >> log2Size) << log2Size;
+    const int y0 = (y >> log2Size) << log2Size;
+    if (img->get_log2CbSize(x0, y0) == log2Size) {
+      out->log2CbSize = (uint8_t)log2Size;
+      out->PartMode   = (uint8_t)img->get_PartMode(x0, y0);
+      break;
+    }
+  }
+
+  // These are written to every unit of the CB.
+  out->ctDepth              = (uint8_t)img->get_ctDepth(x, y);
+  out->PredMode             = (uint8_t)img->get_pred_mode(x, y);
+  out->pcm_flag             = (uint8_t)img->get_pcm_flag(x, y);
+  out->cu_transquant_bypass = (uint8_t)img->get_cu_transquant_bypass(x, y);
+  out->QP_Y                 = (int8_t)img->get_QPY(x, y);
+}
+
+
+/* --- PB --- */
+
+de265_internals_layout de265_internals_get_PB_info_layout(const struct de265_image* img)
+{
+  return has_metadata(img) ? layout_of(ia::pb(img)) : empty_layout();
+}
+
+void de265_internals_get_PB_info(const struct de265_image* img, int x4, int y4, de265_internals_pb* out)
+{
+  if (out == NULL) return;
+  memset(out, 0, sizeof(*out));
+  out->refIdx[0] = out->refIdx[1] = -1;
+  if (!inside(de265_internals_get_PB_info_layout(img), x4, y4)) return;
+
+  const int x = x4 << 2;
+  const int y = y4 << 2;
+  if (!inside(de265_internals_get_CB_info_layout(img),
+              x >> ia::cb(img).log2unitSize, y >> ia::cb(img).log2unitSize)) return;
+  // The motion array is not cleared per picture: intra blocks keep stale vectors.
+  if (img->get_pred_mode(x, y) == MODE_INTRA) return;
+
+  const PBMotion& mv = img->get_mv_info(x, y);
+  const slice_segment_header* shdr = slice_at(img, x, y);
+  for (int l = 0; l < 2; l++) {
+    if (!mv.predFlag[l]) continue;
+    out->predFlag[l] = 1;
+    out->refIdx[l]   = mv.refIdx[l];
+    out->mv_x[l]     = mv.mv[l].x;
+    out->mv_y[l]     = mv.mv[l].y;
+    if (shdr != NULL && mv.refIdx[l] >= 0 && mv.refIdx[l] < MAX_NUM_REF_PICS) {
+      out->refPOC[l]        = shdr->RefPicList_POC[l][mv.refIdx[l]];
+      out->refIsLongTerm[l] = shdr->LongTermRefPic[l][mv.refIdx[l]] ? 1 : 0;
+    }
+  }
+}
+
+
+/* --- intra --- */
+
+de265_internals_layout de265_internals_get_intra_info_layout(const struct de265_image* img)
+{
+  return has_metadata(img) ? layout_4x4(ia::ipm(img)) : empty_layout();
+}
+
+void de265_internals_get_intra_modes(const struct de265_image* img, int x4, int y4,
+                                     uint8_t* intraPredModeY, uint8_t* intraPredModeC)
+{
+  uint8_t modeY = 255, modeC = 255;
+
+  if (inside(de265_internals_get_intra_info_layout(img), x4, y4)) {
+    const int x = x4 << 2;
+    const int y = y4 << 2;
+    // The mode arrays are not cleared per picture: only intra blocks hold valid modes.
+    if (inside(de265_internals_get_CB_info_layout(img),
+               x >> ia::cb(img).log2unitSize, y >> ia::cb(img).log2unitSize) &&
+        img->get_pred_mode(x, y) == MODE_INTRA) {
+      modeY = (uint8_t)img->get_IntraPredMode(x, y);
+      modeC = (uint8_t)img->get_IntraPredModeC(x, y);
+    }
+  }
+
+  if (intraPredModeY) *intraPredModeY = modeY;
+  if (intraPredModeC) *intraPredModeC = modeC;
+}
+
+
+/* --- TU --- */
+
+de265_internals_layout de265_internals_get_TU_info_layout(const struct de265_image* img)
+{
+  return has_metadata(img) ? layout_4x4(ia::tu(img)) : empty_layout();
+}
+
+uint8_t de265_internals_get_TU_info(const struct de265_image* img, int x4, int y4)
+{
+  if (!inside(de265_internals_get_TU_info_layout(img), x4, y4)) return 0;
+  return ia::tu(img).get(x4 << 2, y4 << 2);
+}
+
+
+/* --- deblocking --- */
+
+de265_internals_layout de265_internals_get_deblk_info_layout(const struct de265_image* img)
+{
+  return has_metadata(img) ? layout_of(ia::deblk(img)) : empty_layout();
+}
+
+uint8_t de265_internals_get_deblk_flags(const struct de265_image* img, int x4, int y4)
+{
+  if (!inside(de265_internals_get_deblk_info_layout(img), x4, y4)) return 0;
+  return img->get_deblk_flags(x4 << 2, y4 << 2);
+}
+
+uint8_t de265_internals_get_deblk_bS_v(const struct de265_image* img, int x4, int y4)
+{
+  if (!inside(de265_internals_get_deblk_info_layout(img), x4, y4)) return 0;
+  const MetaDataArray<uint8_t>& bS = img->deblk_bS_v;
+  if (bS.data == NULL || x4 >= bS.width_in_units || y4 >= bS.height_in_units) return 0;
+  return bS[x4 + y4*bS.width_in_units];
+}
+
+
+/* --- slice headers and picture --- */
+
+int de265_internals_get_num_slice_headers(const struct de265_image* img)
+{
+  return img != NULL ? (int)img->slices.size() : 0;
+}
+
+void de265_internals_get_slice_header(const struct de265_image* img, int index, de265_internals_slice_header* out)
+{
+  if (out == NULL) return;
+  memset(out, 0, sizeof(*out));
+  if (index < 0 || index >= de265_internals_get_num_slice_headers(img)) return;
+
+  const slice_segment_header* s = img->slices[index];
+  out->slice_type            = s->slice_type;
+  out->SliceAddrRs           = s->SliceAddrRS;
+  out->slice_qp_delta        = s->slice_qp_delta;
+  out->SliceQPY              = s->SliceQPY;
+  out->num_ref_idx_l0_active = s->num_ref_idx_l0_active;
+  out->num_ref_idx_l1_active = s->num_ref_idx_l1_active;
+  for (int l = 0; l < 2; l++) {
+    for (int i = 0; i < 16 && i < MAX_NUM_REF_PICS; i++) {
+      out->RefPicList_POC[l][i]      = s->RefPicList_POC[l][i];
+      out->RefPicList_LongTerm[l][i] = s->LongTermRefPic[l][i] ? 1 : 0;
+    }
+  }
+  out->MaxNumMergeCand                       = s->MaxNumMergeCand;
+  out->slice_deblocking_filter_disabled_flag = s->slice_deblocking_filter_disabled_flag;
+  out->slice_beta_offset_div2                = s->slice_beta_offset / 2;  // libde265 stores the doubled value
+  out->slice_tc_offset_div2                  = s->slice_tc_offset / 2;
+  out->slice_sao_luma_flag                   = s->slice_sao_luma_flag;
+  out->slice_sao_chroma_flag                 = s->slice_sao_chroma_flag;
+  out->slice_cb_qp_offset                    = s->slice_cb_qp_offset;
+  out->slice_cr_qp_offset                    = s->slice_cr_qp_offset;
+  out->collocated_from_l0_flag               = s->collocated_from_l0_flag;
+  out->collocated_ref_idx                    = s->collocated_ref_idx;
+  out->slice_temporal_mvp_enabled_flag       = s->slice_temporal_mvp_enabled_flag;
+}
+
+int de265_internals_get_picture_poc(const struct de265_image* img)
+{
+  return img != NULL ? img->PicOrderCntVal : 0;
+}
+
+void de265_internals_get_sps_sizes(const struct de265_image* img, int* CtbLog2SizeY, int* MinCbLog2SizeY,
+                                   int* MinTbLog2SizeY, int* PicWidthInCtbsY, int* PicHeightInCtbsY)
+{
+  const bool ok = img != NULL && img->has_sps();
+  const seq_parameter_set* sps = ok ? &img->get_sps() : NULL;
+  if (CtbLog2SizeY)     *CtbLog2SizeY     = ok ? sps->Log2CtbSizeY     : 0;
+  if (MinCbLog2SizeY)   *MinCbLog2SizeY   = ok ? sps->Log2MinCbSizeY   : 0;
+  if (MinTbLog2SizeY)   *MinTbLog2SizeY   = ok ? sps->Log2MinTrafoSize : 0;
+  if (PicWidthInCtbsY)  *PicWidthInCtbsY  = ok ? sps->PicWidthInCtbsY  : 0;
+  if (PicHeightInCtbsY) *PicHeightInCtbsY = ok ? sps->PicHeightInCtbsY : 0;
+}
