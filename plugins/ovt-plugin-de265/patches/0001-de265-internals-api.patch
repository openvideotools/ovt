--- /dev/null
+++ b/libde265/de265_internals.h
@@ -0,0 +1,174 @@
+/*
+ * H.265 video codec.
+ * Copyright (c) 2026 The Open Video Tools contributors
+ *
+ * This file is part of libde265.
+ *
+ * libde265 is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as
+ * published by the Free Software Foundation, either version 3 of
+ * the License, or (at your option) any later version.
+ *
+ * libde265 is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with libde265.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/* de265_internals.h -- read-only access to per-picture metadata (OVT patch 0001).
+ *
+ * Built only with the CMake option DE265_INTERNALS=ON. Every function reads the metadata
+ * that the decoder already keeps for a decoded picture (the image returned by
+ * de265_get_next_picture()) and is valid until de265_release_next_picture().
+ *
+ * Coordinates are always in units of the layout returned by the matching *_layout()
+ * function, never in luma samples: (unit_x, unit_y) for MinCb units, (x4, y4) for 4x4
+ * units, (ctb_x, ctb_y) for CTBs. A coordinate outside the layout, or a NULL image,
+ * yields zero (structures are zero-filled).
+ */
+
+#ifndef DE265_INTERNALS_H
+#define DE265_INTERNALS_H
+
+#include <libde265/de265.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct de265_internals_layout {
+  int log2_unit_size;
+  int width_in_units;
+  int height_in_units;
+} de265_internals_layout;
+
+/* --- CTB (coding tree block) info: unit = CTB --- */
+
+LIBDE265_API de265_internals_layout de265_internals_get_CTB_info_layout(const struct de265_image*);
+/* index into the slice header table (de265_internals_get_slice_header) */
+LIBDE265_API uint16_t de265_internals_get_CTB_slice_header_index(const struct de265_image*, int ctb_x, int ctb_y);
+/* SliceAddrRs: address of the first CTB of the independent slice */
+LIBDE265_API int      de265_internals_get_CTB_slice_addr_rs(const struct de265_image*, int ctb_x, int ctb_y);
+
+typedef struct de265_internals_sao {
+  uint8_t SaoTypeIdx[3];        /* per component: 0 not applied, 1 band offset, 2 edge offset */
+  int8_t  SaoOffsetVal[3][4];   /* SaoOffsetVal[cIdx][i+1] of H.265 7.4.9.3.2 (SaoOffsetVal[cIdx][0] is always 0) */
+  uint8_t SaoBandPosition[3];
+  uint8_t SaoEoClass[3];
+} de265_internals_sao;
+
+LIBDE265_API void     de265_internals_get_CTB_sao(const struct de265_image*, int ctb_x, int ctb_y, de265_internals_sao* out);
+
+#define DE265_INTERNALS_CTB_FLAG_PCM_OR_TRANSQUANT_BYPASS (1<<0)
+#define DE265_INTERNALS_CTB_FLAG_DEBLOCKING_DISABLED      (1<<1)
+/* bit0 has_pcm_or_cu_transquant_bypass, bit1 deblocking disabled for this CTB's slice */
+LIBDE265_API uint8_t  de265_internals_get_CTB_flags(const struct de265_image*, int ctb_x, int ctb_y);
+
+/* --- CB (coding block) info: unit = MinCb (log2 = MinCbLog2SizeY) ---
+   Values are valid at every unit covered by the CB, not only at its top-left unit. */
+
+LIBDE265_API de265_internals_layout de265_internals_get_CB_info_layout(const struct de265_image*);
+
+typedef struct de265_internals_cb {
+  uint8_t log2CbSize;            /* 3..6; 0 when the unit was not decoded */
+  uint8_t PartMode;              /* enum PartMode: 0 2Nx2N 1 2NxN 2 Nx2N 3 NxN 4 2NxnU 5 2NxnD 6 nLx2N 7 nRx2N */
+  uint8_t ctDepth;
+  uint8_t PredMode;              /* 0 MODE_INTRA, 1 MODE_INTER, 2 MODE_SKIP (cu_skip_flag set) */
+  uint8_t pcm_flag;
+  uint8_t cu_transquant_bypass;
+  int8_t  QP_Y;
+} de265_internals_cb;
+
+LIBDE265_API void     de265_internals_get_CB_info(const struct de265_image*, int unit_x, int unit_y, de265_internals_cb* out);
+
+/* --- PB (prediction block) motion: unit = 4x4 --- */
+
+LIBDE265_API de265_internals_layout de265_internals_get_PB_info_layout(const struct de265_image*);
+
+typedef struct de265_internals_pb {
+  uint8_t predFlag[2];
+  int8_t  refIdx[2];             /* -1 when predFlag[list] is 0 */
+  int16_t mv_x[2];               /* quarter-sample; 0 when predFlag[list] is 0 */
+  int16_t mv_y[2];
+  int32_t refPOC[2];             /* RefPicList_POC[list][refIdx] of the PB's slice; 0 when unused */
+  int8_t  refIsLongTerm[2];
+} de265_internals_pb;
+
+/* All fields are zero (refIdx -1) for intra-coded blocks. */
+LIBDE265_API void     de265_internals_get_PB_info(const struct de265_image*, int x4, int y4, de265_internals_pb* out);
+
+/* --- Intra prediction modes: unit = 4x4 --- */
+
+LIBDE265_API de265_internals_layout de265_internals_get_intra_info_layout(const struct de265_image*);
+/* intraPredModeY 0..34; intraPredModeC is the derived chroma mode. Both 255 for blocks that are
+   not intra-coded. Either pointer may be NULL. */
+LIBDE265_API void     de265_internals_get_intra_modes(const struct de265_image*, int x4, int y4,
+                                                      uint8_t* intraPredModeY, uint8_t* intraPredModeC);
+
+/* --- TU (transform unit) info: unit = 4x4 --- */
+
+LIBDE265_API de265_internals_layout de265_internals_get_TU_info_layout(const struct de265_image*);
+#define DE265_INTERNALS_TU_FLAG_SPLIT_TRANSFORM_MASK 0x1F    /* bit d = split_transform_flag at depth d (0..4) */
+#define DE265_INTERNALS_TU_FLAG_NONZERO_COEFF        (1<<7)
+/* raw tu_info byte */
+LIBDE265_API uint8_t  de265_internals_get_TU_info(const struct de265_image*, int x4, int y4);
+
+/* --- Deblocking: unit = 4x4 --- */
+
+LIBDE265_API de265_internals_layout de265_internals_get_deblk_info_layout(const struct de265_image*);
+#define DE265_INTERNALS_DEBLOCK_BS_MASK       0x03    /* bS of the edge derived last for this 4x4 */
+#define DE265_INTERNALS_DEBLOCK_FLAG_VERTI    (1<<4)  /* transform or CB edge on the left */
+#define DE265_INTERNALS_DEBLOCK_FLAG_HORIZ    (1<<5)  /* transform or CB edge on the top */
+#define DE265_INTERNALS_DEBLOCK_PB_EDGE_VERTI (1<<6)  /* prediction-block edge on the left */
+#define DE265_INTERNALS_DEBLOCK_PB_EDGE_HORIZ (1<<7)  /* prediction-block edge on the top */
+/* raw deblk_info byte. libde265 keeps one bS per 4x4 and the horizontal-edge pass overwrites
+   the vertical-edge value, so on the rows that pass visits (every 8th luma row) the bS bits
+   hold the HORIZONTAL edge's bS. Use de265_internals_get_deblk_bS_v() for vertical edges. */
+LIBDE265_API uint8_t  de265_internals_get_deblk_flags(const struct de265_image*, int x4, int y4);
+/* bS 0..2 of the vertical edge on the left of the 4x4 at (x4, y4), as derived by the
+   deblocking filter (H.265 8.7.2.4). 0 when that edge is neither a transform nor a
+   prediction-block edge, when it is not on the 8x8 deblocking grid, and when deblocking
+   is disabled for the picture. */
+LIBDE265_API uint8_t  de265_internals_get_deblk_bS_v(const struct de265_image*, int x4, int y4);
+
+/* --- Slice headers and picture-level data --- */
+
+LIBDE265_API int      de265_internals_get_num_slice_headers(const struct de265_image*);
+
+typedef struct de265_internals_slice_header {
+  int slice_type;                /* 0 B, 1 P, 2 I */
+  int SliceAddrRs;
+  int slice_qp_delta;
+  int SliceQPY;
+  int num_ref_idx_l0_active;
+  int num_ref_idx_l1_active;
+  int32_t RefPicList_POC[2][16];
+  int8_t  RefPicList_LongTerm[2][16];
+  int MaxNumMergeCand;
+  int slice_deblocking_filter_disabled_flag;
+  int slice_beta_offset_div2;
+  int slice_tc_offset_div2;
+  int slice_sao_luma_flag;
+  int slice_sao_chroma_flag;
+  int slice_cb_qp_offset;
+  int slice_cr_qp_offset;
+  int collocated_from_l0_flag;
+  int collocated_ref_idx;
+  int slice_temporal_mvp_enabled_flag;
+} de265_internals_slice_header;
+
+LIBDE265_API void     de265_internals_get_slice_header(const struct de265_image*, int index, de265_internals_slice_header* out);
+/* PicOrderCntVal */
+LIBDE265_API int      de265_internals_get_picture_poc(const struct de265_image*);
+/* Any pointer may be NULL. */
+LIBDE265_API void     de265_internals_get_sps_sizes(const struct de265_image*, int* CtbLog2SizeY, int* MinCbLog2SizeY,
+                                                    int* MinTbLog2SizeY, int* PicWidthInCtbsY, int* PicHeightInCtbsY);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
