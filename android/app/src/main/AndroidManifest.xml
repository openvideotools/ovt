  Manifest of OVT Studio for Android and ChromeOS (chapter 13 §13.4.5; WI-0.050). extractNativeLibs=false is
  not written here: AGP 8 sets it in the merged manifest from packaging.jniLibs.useLegacyPackaging = false
  (app/build.gradle.kts) and warns when the source manifest carries it. WI-A.450 added the chapter 11 §11.5.1 entries
  (ACTION_SEND, the file extensions, the ChromeOS free-form window preferences); WI-0.053 adds the codec-pack
  declarations.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="false" />
    <!-- Chromebooks without a touch screen. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- No INTERNET permission (§13.4.5: F-Droid anti-feature), even if a library manifest asks for it. The play
         flavour's Feature Delivery needs it once WI-0.053 adds that library. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.OVT"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <!-- ChromeOS multi-window. -->
        <meta-data android:name="android.allow_multiple_resumed_activities" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:colorMode="hdr"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <!-- ChromeOS free-form defaults (§11.5.1): open maximised, in landscape. -->
            <meta-data android:name="WindowManagerPreference:FreeformWindowSize" android:value="maximize" />
            <meta-data android:name="WindowManagerPreference:FreeformWindowOrientation" android:value="landscape" />
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="800dp"
                android:minWidth="800dp"
                android:minHeight="600dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Share-to (§11.5.1): a video or a raw stream sent from another app (FilePicker.handleIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- The extensions of §11.5.1, for providers that report another MIME type (text/plain for .y4m, application/json
                 for .ovtproj). pathPattern only applies with a scheme and a host; ".*" matches lazily, so each extension
                 also has a form for paths with an earlier dot. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\..*\\.mp4" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\..*\\.mov" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\..*\\.m4v" />
                <data android:pathPattern=".*\\.ivf" />
                <data android:pathPattern=".*\\..*\\.ivf" />
                <data android:pathPattern=".*\\.obu" />
                <data android:pathPattern=".*\\..*\\.obu" />
                <data android:pathPattern=".*\\.h264" />
                <data android:pathPattern=".*\\..*\\.h264" />
                <data android:pathPattern=".*\\.264" />
                <data android:pathPattern=".*\\..*\\.264" />
                <data android:pathPattern=".*\\.h265" />
                <data android:pathPattern=".*\\..*\\.h265" />
                <data android:pathPattern=".*\\.hevc" />
                <data android:pathPattern=".*\\..*\\.hevc" />
                <data android:pathPattern=".*\\.y4m" />
                <data android:pathPattern=".*\\..*\\.y4m" />
                <data android:pathPattern=".*\\.yuv" />
                <data android:pathPattern=".*\\..*\\.yuv" />
                <data android:pathPattern=".*\\.ovtproj" />
                <data android:pathPattern=".*\\..*\\.ovtproj" />
            </intent-filter>
        </activity>
    </application>
</manifest>
