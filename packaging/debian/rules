#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 The Open Video Tools contributors
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Debian build (WI-0.072). Configures with the linux-x64-distro preset (system libraries, no vcpkg), then installs
# into debian/tmp and lets the *.install files split the result into binary packages.
# The preset is a configure preset on x86_64; other architectures use the same cache variables through -D flags
# once linux-arm64 distro support is specified (not in scope).

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

PRESET := linux-x64-distro
BUILDDIR := build/$(PRESET)

%:
	dh $@

override_dh_auto_configure:
	cmake --preset $(PRESET) \
	  -DCMAKE_INSTALL_PREFIX=/usr \
	  -DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
	  -DOVT_BUILD_PYTHON=ON \
	  -DOVT_BUILD_TESTS=OFF \
	  -DOVT_NOTICES_REQUIRED=ON

override_dh_auto_build:
	cmake --build --preset $(PRESET) --parallel $(or $(DEB_BUILD_OPTION_PARALLEL),1)

# Tests run in CI (ctest --preset pr); the distro build only needs the product.
override_dh_auto_test:

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp cmake --install $(BUILDDIR)
