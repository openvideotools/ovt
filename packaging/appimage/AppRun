#
# AppRun of the OVT Studio AppImage (chapter 13 §13.6.2, WI-0.070). tools/linux/appimage.sh passes this file to
# linuxdeploy as --custom-apprun, so it replaces linuxdeploy's own AppRun and must source the apprun-hooks itself
# (the Qt plugin writes the QT_PLUGIN_PATH / QML_IMPORT_PATH / platform-theme setup there).
#
#   OVT_Studio-<ver>-<arch>.AppImage [args]              starts the GUI (ovt-studio)
#   OVT_Studio-<ver>-<arch>.AppImage --ovt-cli [args]    runs the CLI (`ovt plugins`, `ovt probe ...`) in the same
#                                                        environment; a symlink named `ovt` to the AppImage does too
#
# POSIX sh only: it runs on every host distribution, whatever /bin/sh is.

set -eu

# $APPDIR is set by the AppImage runtime; fall back to the directory of this file for `--appimage-extract` trees.
if [ -z "${APPDIR:-}" ]; then
  APPDIR=$(cd "$(dirname "$0")" && pwd)
fi
export APPDIR

# Vulkan: the loader (libvulkan.so.1) is deliberately NOT bundled so the host ICDs load; nothing here points at
# VK_ICD_FILENAMES.
usr="$APPDIR/usr"
export PATH="$usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# Plugins (§7.5.1): the bundled directory first. A user who sets OVT_PLUGIN_PATH keeps it and gets ours appended,
# so `OVT_PLUGIN_PATH=~/plugins:` style overrides still see the bundled aom plugin. The codec pack extracts into
# $XDG_DATA_HOME/ovt/plugins, which the default search path already covers.
bundled_plugins="$usr/lib/ovt/plugins"
if [ -n "${OVT_PLUGIN_PATH:-}" ]; then
  case ":$OVT_PLUGIN_PATH:" in
    *":$bundled_plugins:"*) ;;
    *) OVT_PLUGIN_PATH="${OVT_PLUGIN_PATH%:}:$bundled_plugins" ;;
  esac
else
  OVT_PLUGIN_PATH="$bundled_plugins"
fi
export OVT_PLUGIN_PATH

# Hooks written by linuxdeploy plugins. They are shell fragments meant to be sourced.
if [ -d "$APPDIR/apprun-hooks" ]; then
  for hook in "$APPDIR"/apprun-hooks/*.sh; do
    # shellcheck disable=SC1090 # generated by linuxdeploy plugins at packaging time
    [ -r "$hook" ] && . "$hook"
  done
fi

self=${ARGV0:-$0}
case "$(basename "$self")" in
  ovt) exec "$usr/bin/ovt" "$@" ;;
esac
if [ "${1:-}" = "--ovt-cli" ]; then
  shift
  exec "$usr/bin/ovt" "$@"
fi
exec "$usr/bin/ovt-studio" "$@"
