#
# Cache unit tests (WI-0.091). Catch2's CHECK/REQUIRE macros expand to branches, so a test case made of
# assertions trips readability-function-cognitive-complexity with almost no control flow of its own. Count
# only the test's own branches (same relaxation as core/tests/model/ and core/tests/bitreader/).
InheritParentConfig: true
CheckOptions:
  readability-function-cognitive-complexity.IgnoreMacros: true
