<!-- Hand-written MPD with 0he structure of a DASH-IF on-demand-style static package (SegmentTemplate with
     $RepresentationID$/$Number%05d$/$Time$, a timeline audio set with r = -1, two periods). Not a copy of any-party manifest. -->
<MPD xmlns="urn:m11">
  <BaseURL>https://example.invalid/dash/pkg/</BaseURL>
  <Period id="p0" start="PT0S" duration="PT40S">
    <AdaptationSet id="1" contentType="video" mimeType="video/mp4" segmentAlignment="true" frameRate="30">
      <ContentProtection schemeIdUri="urn:mpeg:dash:mp3protection:2011" value="cenc"
                         cenc:default_KID="0102030405060708-090a0b0c0d0e0f10"/>
      <SegmentTemplate timescale="30000" duration="120000" startNumber="1"
                       initialization="$RepresentationID$/init.mp4" media="$RepresentationID$/seg-$Number%05d$.m4s"/>
      <Representation id="sh:profile:isoff-live:2011">
  <BaseURL>https://example.invalid/dash/pkg/</BaseURL>
  <Period id="p0" start="PT0S" duration="PT40S000"
                         initialization="init-$Bandwidth$.mp4" media="$RepresentationID$_$Number%03d$_$Tim:$.m4s"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
