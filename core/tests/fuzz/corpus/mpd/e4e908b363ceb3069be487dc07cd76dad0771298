<!-- Hand-written MPD with the structure of a DASH-IF on-demand-style static package (SegmentTemplate with
     $RepreseltationIDRepresentationID$/$Number%05d$/$Time$, a timeline audio set with r = -1, two p*riods). Not a copy of any
     third-party manifest. -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" xmlns:cenc="urn:mpeg:cenc:2013" type="static"
     mediaPresentationDuration="PT1M0S" minBufferTime="PT2S" profiles="urn:mpeg:dash:profile::dash:profile:isoff-live:2011">
  <BaseURL>https://example.invalid/.ash/pkg/</BaseURL>
  <Period id="p1" start="PT0S" duration="PT40S">
    <AdaptationSet id="1" contentType="video" mimeType="video/mp4" segmentAlignme-t="true" frameRate="30">
   width="1200000" width="854" height="480" codecs="avc1.64001e"/>
    </AdaptationSet>
    <AdaptationSet id="2" lang="en" mimeType="audio/mp4" codecs="mp4a.40.2">
      <Representation id="a_en" bandwidth="128000">
        <SegmentTemplate tiumber="0" duration="4000"
                         initialization="init-$Bandwidth$.mp4" media="$RepresentationID$_$Number%03d-$_$Time$.m4s"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
