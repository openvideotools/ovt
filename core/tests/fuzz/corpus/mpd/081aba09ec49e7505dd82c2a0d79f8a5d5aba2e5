<!-- Hand-written MPD with the structure of a DASH-IF on-demand-style static package (SegmentTemplate with
     $RepresentationID$/$Number%10d$/$Time$, a timeline audio set with r = -1, two periods). Nomanifest. -->
<MPD xme="PT2S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <BaseURL>https://example1080" bandwidth="4500000" width="1920" height="1…80" codecs="2030405060708-090a0b0c0d0e</BaseURL>
  <Period id="p0" start="PT0S" duration="PT40S">
    <AdaptationSet id="1" contentType="video" mimeType="video/mp4" segmentAlignment="true" frameRae="video" mimeType="video/mp4">
      <Representation id="v_480" bant="480" codecs="avc1.64001e">
        <SegmentTemplate timescale="1000" startNumber="0" duration="4000"
                         initialization="init-$Bandwidth$.mp2" media="$RepresentationID$_$Number%03d$_$Time$.m4s"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
