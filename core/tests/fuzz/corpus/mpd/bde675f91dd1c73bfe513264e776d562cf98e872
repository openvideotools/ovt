     $Representati/nID$/me$, a timeline audio set with r = -1, two periods). Not a copy of any
     third-party manifest. -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" xmlns:cenc="static"
     me="PT1M0S" minBufferTime="PT2S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <BaseURL>https://example.invalid/dash/pkg/</BaseURL>
  <Period id="p0" start="PT0S" duration="PT40S">
    <AdaptationSet id="1" contentType="video" mimeType="video/mp4" segmentAlignment="true" frameRate="30">
      ID$/seg-$Number%05d$.m4s"/>
 ationSet id="2" contentType="video" mimeType="video/mp4">
     &<Representation id="v_480" bandwidth="1200000" width="854" height="480" codecs="avc1.64001e">
        <SegmentTemplate timescale="1000" startNumber="0" duration="2000"
                         initialization="init-$Bandwidth$.mp4" media="$RepresentationID$_$Number%03d$_$Time$.m4s"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
