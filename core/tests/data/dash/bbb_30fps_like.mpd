<!-- Hand-written MPD with the structure of a DASH-IF on-demand-style static package (SegmentTemplate with
     $RepresentationID$/$Number%05d$/$Time$, a timeline audio set with r = -1, two periods). Not a copy of any
     third-party manifest. -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" xmlns:cenc="urn:mpeg:cenc:2013" type="static"
     mediaPresentationDuration="PT1M0S" minBufferTime="PT2S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <BaseURL>https://example.invalid/dash/pkg/</BaseURL>
  <Period id="p0" start="PT0S" duration="PT40S">
    <AdaptationSet id="1" contentType="video" mimeType="video/mp4" segmentAlignment="true" frameRate="30">
      <ContentProtection schemeIdUri="urn:mpeg:dash:mp4protection:2011" value="cenc"
                         cenc:default_KID="0102030405060708-090a0b0c0d0e0f10"/>
      <SegmentTemplate timescale="30000" duration="120000" startNumber="1"
                       initialization="$RepresentationID$/init.mp4" media="$RepresentationID$/seg-$Number%05d$.m4s"/>
      <Representation id="v_1080" bandwidth="4500000" width="1920" height="1080" codecs="avc1.640028"/>
      <Representation id="v_480" bandwidth="1200000" width="854" height="480" codecs="avc1.64001e"/>
    </AdaptationSet>
    <AdaptationSet id="2" lang="en" mimeType="audio/mp4" codecs="mp4a.40.2">
      <Representation id="a_en" bandwidth="128000">
        <SegmentTemplate timescale="48000" initialization="a/$RepresentationID$/init.mp4"
                         media="a/$RepresentationID$/$Time$.m4s">
          <SegmentTimeline>
            <S t="0" d="192000" r="1"/>
            <S d="96000"/>
            <S d="192000" r="-1"/>
          </SegmentTimeline>
        </SegmentTemplate>
      </Representation>
    </AdaptationSet>
  </Period>
  <Period id="p1" duration="PT20S">
    <BaseURL>p1/</BaseURL>
    <AdaptationSet id="1" contentType="video" mimeType="video/mp4">
      <Representation id="v_480" bandwidth="1200000" width="854" height="480" codecs="avc1.64001e">
        <SegmentTemplate timescale="1000" startNumber="0" duration="4000"
                         initialization="init-$Bandwidth$.mp4" media="$RepresentationID$_$Number%03d$_$Time$.m4s"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
