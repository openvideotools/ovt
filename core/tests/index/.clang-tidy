#
# Index module unit tests (AV1 slot model and frame boundaries, WI-1.119). Catch2's CHECK/REQUIRE macros expand to
# branches, so a table-driven test case trips readability-function-cognitive-complexity on code that has almost no
# control flow of its own. Count only the test's own branches.
InheritParentConfig: true
CheckOptions:
  readability-function-cognitive-complexity.IgnoreMacros: true
