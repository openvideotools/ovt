#
# WI-0.094: derives ovt_model_v1_plus.fbs from core/schema/ovt_model.fbs. The copy is the real schema moved to
# namespace ovt.fb.evo with one field appended to FrameAnalysis, Block and CellGrid and one value appended to
# PredKind: what a later minor version of schema major 1 may add under the additive rule (chapter 06 §6.1 P7).
#
#   cmake -D IN=<ovt_model.fbs> -D OUT=<file> -P make_v1_plus.cmake              writes the copy
#   cmake -D IN=<ovt_model.fbs> -D CHECK=<committed copy> -P make_v1_plus.cmake   fails when the committed copy
#                                                                                  differs from a fresh one
#
# The ctest schema_evolution_v1_plus_up_to_date runs the CHECK form, so a change to ovt_model.fbs that is not
# followed by a regenerated copy fails the fast lane (regenerate with the first form, OUT=the committed path).

cmake_minimum_required(VERSION 3.25)

if(NOT IN)
  message(FATAL_ERROR "make_v1_plus.cmake: IN=<ovt_model.fbs> is required")
endif()
file(READ "${IN}" fbs)

# Replaces the first occurrence of `from` with `to`; fails when `from` is absent, so that a reworded schema is
# noticed here instead of producing a copy without the evolution.
function(_evo_replace from to)
  string(FIND "${fbs}" "${from}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "make_v1_plus.cmake: '${from}' not found in ${IN}")
  endif()
  string(LENGTH "${from}" len)
  string(SUBSTRING "${fbs}" 0 ${pos} head)
  math(EXPR tail_at "${pos} + ${len}")
  string(SUBSTRING "${fbs}" ${tail_at} -1 tail)
  set(fbs "${head}${to}${tail}" PARENT_SCOPE)
endfunction()

# Appends `field` as the last field of `table` (before the closing brace that ends the table's block).
function(_evo_append_field table field)
  string(FIND "${fbs}" "table ${table} {" start)
  if(start EQUAL -1)
    message(FATAL_ERROR "make_v1_plus.cmake: table ${table} not found in ${IN}")
  endif()
  string(SUBSTRING "${fbs}" ${start} -1 rest)
  string(FIND "${rest}" "\n}" close)
  if(close EQUAL -1)
    message(FATAL_ERROR "make_v1_plus.cmake: no closing brace for table ${table}")
  endif()
  math(EXPR at "${start} + ${close} + 1")
  string(SUBSTRING "${fbs}" 0 ${at} head)
  string(SUBSTRING "${fbs}" ${at} -1 tail)
  set(fbs "${head}  ${field}\n${tail}" PARENT_SCOPE)
endfunction()

_evo_replace("namespace ovt.fb;" "namespace ovt.fb.evo;")
_evo_replace("enum PredKind : ubyte { None, Intra, Inter, Skip, IntraBC, PCM, Palette }"
             "enum PredKind : ubyte { None, Intra, Inter, Skip, IntraBC, PCM, Palette, EvoFuture }")
_evo_append_field(CellGrid "evo_cells:[ushort];                          // WI-0.094 evolution field")
_evo_append_field(Block "evo_score:uint = 7;             // WI-0.094 evolution field (non-zero default)")
_evo_append_field(FrameAnalysis "evo_note:string;                 // WI-0.094 evolution field")

set(banner "// GENERATED by core/tests/schema/make_v1_plus.cmake from core/schema/ovt_model.fbs (WI-0.094).\n")
string(APPEND banner "// SPDX-FileCopyrightText: 2026 The Open Video Tools contributors\n")
string(APPEND banner
       "// Test-only copy: namespace ovt.fb.evo, one field appended to FrameAnalysis, Block and CellGrid,\n")
string(APPEND banner
       "// one value appended to PredKind. Do not edit; regenerate after every change to ovt_model.fbs.\n")
set(fbs "${banner}${fbs}")

if(CHECK)
  file(READ "${CHECK}" committed)
  if(NOT committed STREQUAL fbs)
    message(FATAL_ERROR "${CHECK} is out of date with ${IN}. Regenerate it:\n"
                        "  cmake -D IN=${IN} -D OUT=${CHECK} -P ${CMAKE_CURRENT_LIST_FILE}")
  endif()
elseif(OUT)
  file(WRITE "${OUT}" "${fbs}")
else()
  message(FATAL_ERROR "make_v1_plus.cmake: OUT=<file> or CHECK=<file> is required")
endif()
