{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovt.dev/schema/SyntaxNode.schema.json",
  "title": "ovt.fb.SyntaxNode as written by `ovt -f json` (chapter 12 §12.1.4)",
  "$comment": "Generated by tools/fbs_to_jsonschema.py from core/schema/*.fbs (WI-1.501). Do not edit.",
  "$ref": "#/$defs/SyntaxNode",
  "$defs": {
    "_UInt64": {
      "$comment": "ulong: a JSON integer, or a decimal string when the value exceeds 2^53 - 1 (§12.1.4).",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    },
    "_Int64": {
      "$comment": "long: a JSON integer, or a decimal string when |value| exceeds 2^53 - 1 (§12.1.4).",
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      ]
    },
    "_Bytes": {
      "$comment": "[ubyte]: a base64 string (§12.1.4; lowercase hex is also a valid base64 alphabet string) or an array of integers (§6.8.1). SPEC-ASSUMPTION(#285).",
      "anyOf": [
        {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      ]
    },
    "BitSpan": {
      "type": "object",
      "properties": {
        "bit_offset": {
          "$ref": "#/$defs/_UInt64"
        },
        "bit_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/BitSpan"
        },
        "spec_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Severity": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "Info",
            "Warning",
            "Error",
            "Fatal"
          ]
        },
        {
          "type": "integer"
        }
      ]
    },
    "SyntaxNode": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "descriptor": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SyntaxValueKind"
        },
        "uvalue": {
          "$ref": "#/$defs/_UInt64"
        },
        "ivalue": {
          "$ref": "#/$defs/_Int64"
        },
        "bvalue": {
          "type": "boolean"
        },
        "bytes": {
          "$ref": "#/$defs/_Bytes"
        },
        "svalue": {
          "type": "string"
        },
        "enum_name": {
          "type": "string"
        },
        "derived": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/BitSpan"
        },
        "spec_ref": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SyntaxNode"
          }
        },
        "array_index": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "diagnostics": {
          "type": "array",
          "items": {
