#
# Licence tagging of build targets and the licence manifest (chapter 13 §13.2.3, consumed by
# tools/license_gate.py of chapter 15 WI-0.602).
#
#   ovt_set_license(<target> <SPDX expression>)
#       Records the licence of an OVT target in its OVT_LICENSE property. Every OVT target calls it.
#
#   ovt_set_dependency_license(<name> SOURCE <vcpkg|third_party|system|vendored> SPDX <expr>
#                              [VERSION <v>] [LINKAGE <static|shared|plugin|header-only>] [PATCHED])
#       Describes a third-party library that OVT targets link, by the name that appears in
#       LINK_LIBRARIES (an imported target such as fmt::fmt, or a plain library name). Called by the
#       dependency scripts (WI-0.002, WI-0.010). Undescribed libraries are written with spdx
#       "NOASSERTION", which the licence gate rejects as an unknown licence.
#
#   Target ovt_license_manifest
#       Writes ${CMAKE_BINARY_DIR}/license_manifest.json (= build/<preset>/license_manifest.json). The
#       content is computed at the end of configuration by walking each tagged target's LINK_LIBRARIES
#       transitively (OVT targets and imported targets alike) and is copied into place by the target.

include_guard(GLOBAL)

set(OVT_LICENSE_MANIFEST "${CMAKE_BINARY_DIR}/license_manifest.json")
set(_OVT_LICENSE_MANIFEST_STAGED "${CMAKE_BINARY_DIR}/CMakeFiles/ovt_license_manifest.staged.json")

function(ovt_set_license target spdx)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "ovt_set_license: '${target}' is not a target.")
  endif()
  if(spdx STREQUAL "")
    message(FATAL_ERROR "ovt_set_license(${target}): empty SPDX expression.")
  endif()
  set_property(TARGET ${target} PROPERTY OVT_LICENSE "${spdx}")
  get_property(known GLOBAL PROPERTY OVT_LICENSED_TARGETS)
  if(NOT target IN_LIST known)
    set_property(GLOBAL APPEND PROPERTY OVT_LICENSED_TARGETS ${target})
    # DEFER evaluates its arguments when the call runs, so bake the target name in now.
    cmake_language(EVAL CODE "cmake_language(DEFER CALL _ovt_license_target_entry [[${target}]])")
  endif()
endfunction()

function(ovt_set_dependency_license name)
  cmake_parse_arguments(PARSE_ARGV 1 arg "PATCHED" "SOURCE;SPDX;VERSION;LINKAGE" "")
  if(NOT arg_SOURCE MATCHES "^(vcpkg|third_party|system|vendored)$")
    message(FATAL_ERROR "ovt_set_dependency_license(${name}): SOURCE must be vcpkg, third_party, system or vendored.")
  endif()
  if(NOT arg_SPDX)
    message(FATAL_ERROR "ovt_set_dependency_license(${name}): SPDX is required.")
  endif()
  if(arg_LINKAGE AND NOT arg_LINKAGE MATCHES "^(static|shared|plugin|header-only)$")
    message(FATAL_ERROR "ovt_set_dependency_license(${name}): LINKAGE must be static, shared, plugin or header-only.")
  endif()
  set_property(GLOBAL PROPERTY "OVT_DEP_SOURCE_${name}" "${arg_SOURCE}")
  set_property(GLOBAL PROPERTY "OVT_DEP_SPDX_${name}" "${arg_SPDX}")
  set_property(GLOBAL PROPERTY "OVT_DEP_VERSION_${name}" "${arg_VERSION}")
  set_property(GLOBAL PROPERTY "OVT_DEP_LINKAGE_${name}" "${arg_LINKAGE}")
  set_property(GLOBAL PROPERTY "OVT_DEP_PATCHED_${name}" "${arg_PATCHED}")
endfunction()

# Normalises one LINK_LIBRARIES entry: unwraps $<LINK_ONLY:x>, drops other generator expressions,
# linker flags and the ovt::flags interface target. Sets out_var to "" for entries to skip.
function(_ovt_license_normalise_item item out_var)
  set(result "${item}")
  if(result MATCHES "^\\$<LINK_ONLY:(.+)>$")
    set(result "${CMAKE_MATCH_1}")
  endif()
  if(result MATCHES "^\\$<" OR result MATCHES "^-" OR result STREQUAL "")
    set(result "")
  else()
    _ovt_license_resolve("${result}" resolved)
    if(resolved STREQUAL "ovt_flags")
      set(result "")
    endif()
  endif()
  set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

# Resolves an ALIAS target name to the real target; other names are returned unchanged.
function(_ovt_license_resolve name out_var)
  set(result "${name}")
  if(TARGET ${name})
    get_target_property(aliased ${name} ALIASED_TARGET)
    if(aliased)
      set(result "${aliased}")
    endif()
  endif()
  set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

# Collects the transitive set of non-OVT link items of <target> into out_var (sorted, unique), and into
# deps_var the OVT targets reached whose links were already computed.
function(_ovt_license_collect target out_var deps_var)
  set(ovt_deps "")
  set(seen "")
  set(external "")
  set(queue "${target}")
  while(queue)
    list(POP_FRONT queue current)
    if(current IN_LIST seen)
      continue()
    endif()
    list(APPEND seen "${current}")
    if(NOT TARGET ${current})
      continue()
    endif()
    get_target_property(type ${current} TYPE)
    set(items "")
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
      get_target_property(direct ${current} LINK_LIBRARIES)
      if(direct)
        list(APPEND items ${direct})
      endif()
    endif()
    get_target_property(iface ${current} INTERFACE_LINK_LIBRARIES)
    if(iface)
      list(APPEND items ${iface})
    endif()
    foreach(raw IN LISTS items)
      _ovt_license_normalise_item("${raw}" item)
      if(item STREQUAL "")
        continue()
      endif()
      if(TARGET ${item})
        _ovt_license_resolve("${item}" real)
        get_target_property(lic ${real} OVT_LICENSE)
        get_property(done GLOBAL PROPERTY "OVT_LICENSE_LINKS_${real}" SET)
        if(lic AND done)
          # An OVT target whose entry is already computed (in its own directory, where its imported
          # dependencies are visible): reuse its links instead of walking it again from here.
          list(APPEND ovt_deps "${real}")
          continue()
        endif()
        if(NOT lic)
          list(APPEND external "${item}")
        endif()
        list(APPEND queue "${real}")
      else()
        list(APPEND external "${item}")
      endif()
    endforeach()
  endwhile()
  list(REMOVE_DUPLICATES external)
  list(SORT external)
  list(REMOVE_DUPLICATES ovt_deps)
  set(${out_var} "${external}" PARENT_SCOPE)
  set(${deps_var} "${ovt_deps}" PARENT_SCOPE)
endfunction()

# Reads dependency metadata recorded by ovt_set_dependency_license under the name as written or under
# the real target name behind an alias.
function(_ovt_license_dep_property field item out_var)
  get_property(value GLOBAL PROPERTY "OVT_DEP_${field}_${item}")
  if(NOT value)
    _ovt_license_resolve("${item}" real)
    get_property(value GLOBAL PROPERTY "OVT_DEP_${field}_${real}")
  endif()
  set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

function(_ovt_license_linkage item out_var)
  _ovt_license_dep_property(LINKAGE "${item}" linkage)
  if(NOT linkage)
    set(linkage "shared")
    if(TARGET ${item})
      _ovt_license_resolve("${item}" real)
      get_target_property(type ${real} TYPE)
      if(type STREQUAL "STATIC_LIBRARY" OR type STREQUAL "OBJECT_LIBRARY")
        set(linkage "static")
      elseif(type STREQUAL "INTERFACE_LIBRARY")
        set(linkage "header-only")
      elseif(type STREQUAL "MODULE_LIBRARY")
        set(linkage "plugin")
      endif()
    endif()
  endif()
  set(${out_var} "${linkage}" PARENT_SCOPE)
endfunction()

function(_ovt_bool_json value out_var)
  if(value)
    set(${out_var} "true" PARENT_SCOPE)
  else()
    set(${out_var} "false" PARENT_SCOPE)
  endif()
endfunction()

# Builds the manifest entry of one tagged target. Deferred to the end of the directory that called
# ovt_set_license, because imported targets (vcpkg, find_package) are visible only in the directory that
# created them and below; target_link_libraries resolves names in the same scope.
function(_ovt_license_target_entry t)
  get_target_property(type ${t} TYPE)
  string(REGEX REPLACE "_LIBRARY$" "" type "${type}")
  get_target_property(spdx ${t} OVT_LICENSE)
  get_target_property(src_dir ${t} SOURCE_DIR)
  file(RELATIVE_PATH rel "${CMAKE_SOURCE_DIR}" "${src_dir}")
  if(rel STREQUAL "")
    set(rel "./")
  else()
    set(rel "${rel}/")
  endif()

  set(entry "{}")
  string(JSON entry SET "${entry}" "name" "\"${t}\"")
  string(JSON entry SET "${entry}" "type" "\"${type}\"")
  string(JSON entry SET "${entry}" "spdx" "\"${spdx}\"")
  string(JSON entry SET "${entry}" "directory" "\"${rel}\"")

  _ovt_license_collect(${t} externals ovt_deps)
  # Links inherited from OVT targets reached through the walk, keyed by name.
  set(link_names "")
  foreach(dep IN LISTS ovt_deps)
    get_property(dep_names GLOBAL PROPERTY "OVT_LICENSE_LINKS_${dep}")
    foreach(n IN LISTS dep_names)
      if(NOT n IN_LIST link_names AND NOT n IN_LIST externals)
        list(APPEND link_names "${n}")
        get_property(obj GLOBAL PROPERTY "OVT_LICENSE_LINK_${dep}_${n}")
        set(inherited_${n} "${obj}")
      endif()
    endforeach()
  endforeach()
  list(APPEND link_names ${externals})
  list(SORT link_names)
  set(links "[]")
  set(li 0)
  foreach(item IN LISTS link_names)
    if(DEFINED inherited_${item})
      string(JSON links SET "${links}" ${li} "${inherited_${item}}")
      set_property(GLOBAL PROPERTY "OVT_LICENSE_LINK_${t}_${item}" "${inherited_${item}}")
      math(EXPR li "${li} + 1")
      continue()
    endif()
    _ovt_license_dep_property(SOURCE "${item}" source)
    _ovt_license_dep_property(SPDX "${item}" dep_spdx)
    _ovt_license_dep_property(VERSION "${item}" version)
    _ovt_license_dep_property(PATCHED "${item}" patched)
    if(NOT source)
      set(source "system")
    endif()
    if(NOT dep_spdx)
      set(dep_spdx "NOASSERTION")
    endif()
    _ovt_license_linkage("${item}" linkage)
    _ovt_bool_json("${patched}" patched_json)
    set(link "{}")
    string(JSON link SET "${link}" "name" "\"${item}\"")
    string(JSON link SET "${link}" "source" "\"${source}\"")
    string(JSON link SET "${link}" "version" "\"${version}\"")
    string(JSON link SET "${link}" "spdx" "\"${dep_spdx}\"")
    string(JSON link SET "${link}" "linkage" "\"${linkage}\"")
    string(JSON link SET "${link}" "patched" "${patched_json}")
    string(JSON links SET "${links}" ${li} "${link}")
    set_property(GLOBAL PROPERTY "OVT_LICENSE_LINK_${t}_${item}" "${link}")
    math(EXPR li "${li} + 1")
  endforeach()
  set_property(GLOBAL PROPERTY "OVT_LICENSE_LINKS_${t}" "${link_names}")
  string(JSON entry SET "${entry}" "links" "${links}")
  set_property(GLOBAL PROPERTY "OVT_LICENSE_ENTRY_${t}" "${entry}")
endfunction()

# Runs once at the end of the top-level CMakeLists.txt (deferred call), after every directory's entries.
function(_ovt_write_license_manifest)
  set(json "{}")
  string(JSON json SET "${json}" "schema_version" "1")
  string(JSON json SET "${json}" "preset" "\"${OVT_PRESET_NAME}\"")

  set(options "{}")
  foreach(opt OVT_FFMPEG_GPL OVT_FFMPEG_GPL_PLUGIN_ONLY OVT_FFMPEG_GPL_CORE_ACK OVT_PATENT_CODECS_IN_CORE)
    _ovt_bool_json("${${opt}}" b)
    string(JSON options SET "${options}" "${opt}" "${b}")
  endforeach()
  string(JSON json SET "${json}" "options" "${options}")

  get_property(targets GLOBAL PROPERTY OVT_LICENSED_TARGETS)
  list(REMOVE_DUPLICATES targets)
  list(SORT targets)
  set(target_array "[]")
  set(ti 0)
  foreach(t IN LISTS targets)
    get_property(entry GLOBAL PROPERTY "OVT_LICENSE_ENTRY_${t}")
    string(JSON target_array SET "${target_array}" ${ti} "${entry}")
    math(EXPR ti "${ti} + 1")
  endforeach()
  string(JSON json SET "${json}" "targets" "${target_array}")

  # Rewrite the staged file only when the content changes, so the manifest target stays up to date.
  set(old "")
  if(EXISTS "${_OVT_LICENSE_MANIFEST_STAGED}")
    file(READ "${_OVT_LICENSE_MANIFEST_STAGED}" old)
  endif()
  if(NOT old STREQUAL "${json}\n")
    file(WRITE "${_OVT_LICENSE_MANIFEST_STAGED}" "${json}\n")
  endif()
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _ovt_write_license_manifest)

add_custom_command(
  OUTPUT "${OVT_LICENSE_MANIFEST}"
  COMMAND "${CMAKE_COMMAND}" -E copy "${_OVT_LICENSE_MANIFEST_STAGED}" "${OVT_LICENSE_MANIFEST}"
  DEPENDS "${_OVT_LICENSE_MANIFEST_STAGED}"
  COMMENT "Writing ${OVT_LICENSE_MANIFEST}"
  VERBATIM)
add_custom_target(ovt_license_manifest DEPENDS "${OVT_LICENSE_MANIFEST}")
