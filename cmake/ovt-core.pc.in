prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
plugindir=${prefix}/@OVT_PLUGIN_DIR@

Name: ovt-core
Description: Open Video Tools core library (C API)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lovt_core @OVT_PC_SANITIZER_LIBS@
Cflags: -I${includedir}
