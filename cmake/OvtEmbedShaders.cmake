#
# ovt_embed_shaders(<output header> <name> <glsl file> [<name> <glsl file> ...])
#
# Writes a C++ header that holds each GLSL file as `inline constexpr char <name>[]`, a raw string literal, for the
# libplacebo custom shaders of libovt-render (chapter 10; first used by WI-4.452). Paths are relative to the calling
# CMakeLists.txt. Runs at configure time: the files are CMAKE_CONFIGURE_DEPENDS, so editing one re-runs CMake, and
# the header is rewritten only when its content changes (no rebuild otherwise).

include_guard(GLOBAL)

function(ovt_embed_shaders output)
  set(args ${ARGN})
  list(LENGTH args n)
  math(EXPR odd "${n} % 2")
  if(n EQUAL 0 OR odd)
    message(FATAL_ERROR "ovt_embed_shaders: expected <name> <file> pairs, got: ${ARGN}")
  endif()
  set(content "// Generated by cmake/OvtEmbedShaders.cmake from render/src/shaders/. Do not edit.\n")
  string(APPEND content "#pragma once\n\nnamespace ovt::render::detail {\n")
  while(args)
    list(POP_FRONT args name file)
    set(path "${CMAKE_CURRENT_SOURCE_DIR}/${file}")
    if(NOT EXISTS "${path}")
      message(FATAL_ERROR "ovt_embed_shaders: ${path} does not exist")
    endif()
    file(READ "${path}" glsl)
    if(glsl MATCHES "\\)ovt_glsl\"")
      message(FATAL_ERROR "ovt_embed_shaders: ${file} contains the raw-string delimiter )ovt_glsl\"")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    string(APPEND content "\n// ${file}\ninline constexpr char ${name}[] = R\"ovt_glsl(${glsl})ovt_glsl\";\n")
  endwhile()
  string(APPEND content "\n}  // namespace ovt::render::detail\n")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
endfunction()
