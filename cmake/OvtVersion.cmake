#
# Product version (FR-GEN-010): OVT_VERSION_FULL = <VERSION><OVT_VERSION_SUFFIX>+<git sha>.
#
# This file works in two modes:
#  * included from the top-level CMakeLists.txt (configure time): sets OVT_VERSION_FULL, OVT_GIT_SHA and
#    defines the target ovt_version_header, which regenerates the header on every build so that a new
#    commit never leaves a stale sha in the binaries;
#  * run as a script (cmake -P cmake/OvtVersion.cmake) by that target: writes OVT_VERSION_HEADER only
#    when its content changes, so an unchanged sha triggers no rebuild.
#
# Source trees without .git (release tarballs) pass -DOVT_GIT_SHA=<sha>; otherwise the sha is "unknown".

function(_ovt_git_sha source_dir out_var)
  set(sha "")
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
                    WORKING_DIRECTORY "${source_dir}"
                    OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE rc ERROR_QUIET)
    if(NOT rc EQUAL 0)
      set(sha "")
    endif()
  endif()
  if(sha STREQUAL "")
    set(sha "unknown")
  endif()
  set(${out_var} "${sha}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
  # Script mode. Inputs: OVT_SOURCE_DIR, OVT_VERSION, OVT_VERSION_SUFFIX, OVT_VERSION_HEADER,
  # optional OVT_GIT_SHA_OVERRIDE.
  if(OVT_GIT_SHA_OVERRIDE)
    set(sha "${OVT_GIT_SHA_OVERRIDE}")
  else()
    _ovt_git_sha("${OVT_SOURCE_DIR}" sha)
  endif()
  set(full "${OVT_VERSION}${OVT_VERSION_SUFFIX}+${sha}")
  set(content "/* Generated by cmake/OvtVersion.cmake. Do not edit. */
#ifndef OVT_GENERATED_VERSION_FULL_H
#define OVT_GENERATED_VERSION_FULL_H
#define OVT_VERSION_FULL \"${full}\"
#define OVT_GIT_SHA \"${sha}\"
#endif
")
  set(old "")
  if(EXISTS "${OVT_VERSION_HEADER}")
    file(READ "${OVT_VERSION_HEADER}" old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE "${OVT_VERSION_HEADER}" "${content}")
  endif()
  return()
endif()

# OVT_VERSION_SUFFIX and OVT_GIT_SHA are cache options declared in OvtOptions.cmake (included first).
if(OVT_GIT_SHA)
  set(_ovt_sha "${OVT_GIT_SHA}")
else()
  _ovt_git_sha("${CMAKE_SOURCE_DIR}" _ovt_sha)
endif()
set(OVT_VERSION_FULL "${OVT_VERSION}${OVT_VERSION_SUFFIX}+${_ovt_sha}")
unset(_ovt_sha)
message(STATUS "OVT version: ${OVT_VERSION_FULL}")

# Generated-code root of §13.2.3.
set(OVT_GENERATED_DIR "${CMAKE_BINARY_DIR}/generated")
set(OVT_VERSION_HEADER "${OVT_GENERATED_DIR}/ovt_version_full.h")

add_custom_target(ovt_version_header
  COMMAND "${CMAKE_COMMAND}"
          "-DOVT_SOURCE_DIR=${CMAKE_SOURCE_DIR}"
          "-DOVT_VERSION=${OVT_VERSION}"
          "-DOVT_VERSION_SUFFIX=${OVT_VERSION_SUFFIX}"
          "-DOVT_GIT_SHA_OVERRIDE=${OVT_GIT_SHA}"
          "-DOVT_VERSION_HEADER=${OVT_VERSION_HEADER}"
          -P "${CMAKE_CURRENT_LIST_DIR}/OvtVersion.cmake"
  BYPRODUCTS "${OVT_VERSION_HEADER}"
  COMMENT "Updating ${OVT_VERSION_HEADER}"
  VERBATIM)
