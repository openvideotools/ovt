#
# Script mode (cmake -P), run by ctest through the include file of ovt_catch_discover_tests()
# (cmake/OvtTesting.cmake). Lists the Catch2 test cases of TEST_EXECUTABLE with their tags and writes
# CTEST_FILE: one add_test() per test case and its LABELS (tags mapped to label names, chapter 14 §14.2.5).
#
# Inputs (-D): TEST_EXECUTABLE, TEST_WORKING_DIR, TEST_EXTRA_LABELS (;-list),
# TEST_ENVIRONMENT_MODIFICATION (;-list of CTest ENVIRONMENT_MODIFICATION entries, may be empty), CTEST_FILE.

foreach(var TEST_EXECUTABLE TEST_WORKING_DIR CTEST_FILE)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "OvtCatchAddTests.cmake: ${var} is not set")
  endif()
endforeach()

execute_process(
  COMMAND "${TEST_EXECUTABLE}" --list-tests --reporter xml
  WORKING_DIRECTORY "${TEST_WORKING_DIR}"
  OUTPUT_VARIABLE xml
  ERROR_VARIABLE err
  RESULT_VARIABLE rc)
# Catch2 v3 exits with the number of listed tests; only a crash or a non-numeric result is an error.
if(NOT rc MATCHES "^[0-9]+$")
  message(FATAL_ERROR "OvtCatchAddTests.cmake: '${TEST_EXECUTABLE} --list-tests' failed: ${rc}\n${err}")
endif()

# XML entities that can appear in names and tags.
function(_ovt_xml_unescape in out)
  string(REPLACE "&lt;" "<" s "${in}")
  string(REPLACE "&gt;" ">" s "${s}")
  string(REPLACE "&quot;" "\"" s "${s}")
  string(REPLACE "&apos;" "'" s "${s}")
  string(REPLACE "&amp;" "&" s "${s}")
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

# Catch2 (>= 3.3) exits with 4 when every selected test case called SKIP(); SKIP_RETURN_CODE makes ctest
# report that as skipped (chapter 14 §14.2.4: a missing corpus file skips, it does not fail).

# Quotes a value for a bracket argument in the generated file.
function(_ovt_bracket in out)
  set(eq "=")
  while(in MATCHES "\\]${eq}\\]")
    string(APPEND eq "=")
  endwhile()
  set(${out} "[${eq}[${in}]${eq}]" PARENT_SCOPE)
endfunction()

set(content "# Generated by cmake/OvtCatchAddTests.cmake from ${TEST_EXECUTABLE}. Do not edit.\n")
string(REGEX MATCHALL "<TestCase>.*</TestCase>" all "${xml}")
string(REPLACE "</TestCase>" "</TestCase>;" cases "${all}")
foreach(case IN LISTS cases)
  if(NOT case MATCHES "<Name>([^<]*)</Name>")
    continue()
  endif()
  _ovt_xml_unescape("${CMAKE_MATCH_1}" name)
  set(tags "")
  if(case MATCHES "<Tags>([^<]*)</Tags>")
    _ovt_xml_unescape("${CMAKE_MATCH_1}" tags)
  endif()

  set(labels unit ${TEST_EXTRA_LABELS})
  string(REGEX MATCHALL "\\[[^]]+\\]" tag_list "${tags}")
  foreach(tag IN LISTS tag_list)
    string(REGEX REPLACE "^\\[(.*)\\]$" "\\1" tag "${tag}")
    if(tag MATCHES "^[.!]")       # hidden / special tags ([.], [!mayfail]) are not labels
      continue()
    endif()
    string(REGEX REPLACE "[^A-Za-z0-9_]" "_" label "${tag}")
    list(APPEND labels "${label}")
  endforeach()
  list(REMOVE_DUPLICATES labels)
  list(JOIN labels ";" labels)

  # Catch2 treats , [ ] \ * specially in a test spec; escape them so each test runs exactly itself.
  string(REPLACE "\\" "\\\\" spec "${name}")
  foreach(special "," "[" "]" "*")
    string(REPLACE "${special}" "\\${special}" spec "${spec}")
  endforeach()
  _ovt_bracket("${name}" qname)
  _ovt_bracket("${spec}" qspec)
  _ovt_bracket("${labels}" qlabels)
  _ovt_bracket("${TEST_EXECUTABLE}" qexe)
  _ovt_bracket("${TEST_WORKING_DIR}" qwd)
  string(APPEND content
    "add_test(${qname} ${qexe} ${qspec} --reporter console)\n"
    "set_tests_properties(${qname} PROPERTIES WORKING_DIRECTORY ${qwd} LABELS ${qlabels} SKIP_RETURN_CODE 4)\n")
  if(NOT "${TEST_ENVIRONMENT_MODIFICATION}" STREQUAL "")
    _ovt_bracket("${TEST_ENVIRONMENT_MODIFICATION}" qenv)
    string(APPEND content "set_tests_properties(${qname} PROPERTIES ENVIRONMENT_MODIFICATION ${qenv})\n")
  endif()
endforeach()

file(WRITE "${CTEST_FILE}" "${content}")
