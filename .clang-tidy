#
# clang-tidy configuration (chapter 14 §14.8.2, WI-0.559). The warning set for the compiler is the
# ovt::flags target (chapter 13 §13.2.5), not this file. Parser directories (core/src/syntax, container,
# bitreader) override this file with their own .clang-tidy that turns pointer arithmetic into an error
# (§0.7.1: no raw pointer arithmetic on input data).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  -cert-err58-cpp,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  cppcoreguidelines-pro-bounds-pointer-arithmetic,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-init-variables,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -misc-include-cleaner,
  -modernize-use-designated-initializers,
  -modernize-use-ranges,
  -readability-math-missing-parentheses,
  -bugprone-unsafe-functions,
  -cert-msc24-c,
  -cert-msc33-c,
  -bugprone-casting-through-void,
  -bugprone-chained-comparison,
  -bugprone-compare-pointer-to-member-virtual-function,
  -bugprone-crtp-constructor-accessibility,
  -bugprone-empty-catch,
  -bugprone-inc-dec-in-conditions,
  -bugprone-incorrect-enable-if,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-multiple-new-in-one-expression,
  -bugprone-non-zero-enum-to-bool-conversion,
  -bugprone-optional-value-conversion,
  -bugprone-pointer-arithmetic-on-polymorphic-object,
  -bugprone-return-const-ref-from-parameter,
  -bugprone-standalone-empty,
  -bugprone-suspicious-realloc-usage,
  -bugprone-suspicious-stringview-data-usage,
  -bugprone-switch-missing-default-case,
  -bugprone-unique-ptr-array-mismatch,
  -bugprone-unused-local-non-trivial-variable,
  -cert-ctr56-cpp,
  -cert-int09-c,
  -cert-msc54-cpp,
  -clang-analyzer-core.BitwiseShift,
  -clang-analyzer-core.uninitialized.NewArraySize,
  -clang-analyzer-cplusplus.ArrayDelete,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-optin.taint.TaintedAlloc,
  -clang-analyzer-security.PutenvStackArray,
  -clang-analyzer-security.SetgidSetuidOrder,
  -clang-analyzer-security.cert.env.InvalidPtr,
  -clang-analyzer-unix.BlockInCriticalSection,
  -clang-analyzer-unix.Errno,
  -clang-analyzer-unix.StdCLibraryFunctions,
  -clang-analyzer-unix.Stream,
  -misc-coroutine-hostile-raii,
  -misc-header-include-cycle,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -modernize-min-max-use-initializer-list,
  -modernize-type-traits,
  -modernize-use-constraints,
  -modernize-use-starts-ends-with,
  -modernize-use-std-format,
  -modernize-use-std-numbers,
  -modernize-use-std-print,
  -performance-avoid-endl,
  -performance-enum-size,
  -performance-noexcept-destructor,
  -performance-noexcept-swap,
  -readability-avoid-nested-conditional-operator,
  -readability-avoid-return-with-void-value,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-enum-initial-value,
  -readability-operators-representation,
  -readability-redundant-casting,
  -readability-redundant-inline-specifier,
  -readability-reference-to-constructed-temporary,
  -readability-use-std-min-max
# Every check from -misc-include-cleaner down did not exist in clang-tidy 15, the version this set was written
# against. CI now runs clang-tidy 19 (Homebrew llvm@19 on the Mac Mini runners), whose wildcards above would turn
# them on. The list is `clang-tidy-19 --list-checks` minus `clang-tidy-15 --list-checks` under this file. Enabling
# any of them is its own decision, with the tree cleaned up in the same PR.
# WarningsAsErrors is empty on purpose: the errors are set by the callers. The PR job
# (.github/workflows/static-analysis.yml) fails on ANY finding on a changed line, the nightly run uses
# -warnings-as-errors='*', and the parser directories promote pointer arithmetic here.
WarningsAsErrors: ""
# SPEC-ASSUMPTION(#29): core/include (the public C headers) is left out of the header filter. They are C, so
# modernize-use-using cannot be satisfied there; §14.8.2 says "^(core|render|plugins|cli|app)/".
HeaderFilterRegex: '^(core/(src|tests)|render|plugins|cli|app)/'
FormatStyle: file
