#
# PictureHost tests (WI-1.405). Catch2's CHECK/REQUIRE/INFO macros expand to branches, so the acceptance-test loops
# trip readability-function-cognitive-complexity on code with little control flow of its own. Count only the test's
# own branches.
InheritParentConfig: true
CheckOptions:
  readability-function-cognitive-complexity.IgnoreMacros: true
