# Build trees (CMake presets write to build/<preset>/)
/build/
/out/
/.cache/
CMakeUserPresets.json
compile_commands.json

# vcpkg
/vcpkg_installed/

# Corpora are fetched, never committed
/tests/corpora/cache/

# Python
__pycache__/
*.pyc
.venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
/android/local.properties
/android/app/src/main/assets/licenses/


# aqtinstall (tools/install_qt.py) writes its log into the current directory
aqtinstall.log

# Non-stream fixtures regenerated by tests/corpora/synthetic/generate.py --fixtures (hashed in the manifest)
/tests/perf/data/fa_*_dense.bin
/render/tests/fixtures/synthetic_*.fb

# Android Gradle project (WI-0.050): Gradle caches and outputs, IDE files, the signing material (§13.4.8)
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/keystore/
