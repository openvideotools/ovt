{
  "box": {
    "*": {"Version": "version", "Flags": "flags", "EntryCount": "entry_count"},
    "ftyp": {"MajorBrand": "major_brand", "MinorVersion": "minor_version"},
    "styp": {"MajorBrand": "major_brand", "MinorVersion": "minor_version"},
    "mvhd": {"CreationTime": "creation_time", "ModificationTime": "modification_time", "TimeScale": "timescale",
             "Duration": "duration", "NextTrackID": "next_track_ID"},
    "tkhd": {"CreationTime": "creation_time", "ModificationTime": "modification_time", "TrackID": "track_ID",
             "Duration": "duration", "Width": ["width", "fixed16"], "Height": ["height", "fixed16"]},
    "mdhd": {"CreationTime": "creation_time", "ModificationTime": "modification_time", "TimeScale": "timescale",
             "Duration": "duration", "LanguageCode": "language"},
    "hdlr": {"hdlrType": "handler_type", "Name": ["name", "str"]},
    "stsz": {"SampleCount": "sample_count", "ConstantSampleSize": "sample_size"},
    "avc1": {"DataReferenceIndex": "data_reference_index", "Width": "width", "Height": "height",
             "CompressorName": ["compressorname", "str"], "BitDepth": "depth",
             "configurationVersion": "configurationVersion", "AVCProfileIndication": "AVCProfileIndication",
             "profile_compatibility": "profile_compatibility", "AVCLevelIndication": "AVCLevelIndication",
             "nal_unit_size": ["lengthSizeMinusOne", "minus1"]},
    "avcC": {"configurationVersion": "configurationVersion", "AVCProfileIndication": "AVCProfileIndication",
             "profile_compatibility": "profile_compatibility", "AVCLevelIndication": "AVCLevelIndication",
             "nal_unit_size": ["lengthSizeMinusOne", "minus1"]},
    "hvc1": {"DataReferenceIndex": "data_reference_index", "Width": "width", "Height": "height",
             "CompressorName": ["compressorname", "str"], "BitDepth": "depth"},
    "hev1": {"DataReferenceIndex": "data_reference_index", "Width": "width", "Height": "height",
             "CompressorName": ["compressorname", "str"], "BitDepth": "depth"},
    "av01": {"DataReferenceIndex": "data_reference_index", "Width": "width", "Height": "height",
             "CompressorName": ["compressorname", "str"], "BitDepth": "depth"},
    "pasp": {"hSpacing": "hSpacing", "vSpacing": "vSpacing"},
    "btrt": {"BufferSizeDB": "bufferSizeDB", "maxBitRate": "maxBitrate", "avgBitRate": "avgBitrate"},
    "mehd": {"fragmentDuration": "fragment_duration"},
    "trex": {"TrackID": "track_ID", "SampleDescriptionIndex": "default_sample_description_index",
             "SampleDuration": "default_sample_duration", "SampleSize": "default_sample_size"},
    "mfhd": {"FragmentSequenceNumber": "sequence_number"},
    "tfhd": {"TrackID": "track_ID", "SampleDescriptionIndex": "sample_description_index", "SampleDuration": "default_sample_duration",
             "SampleSize": "default_sample_size"},
    "tfdt": {"baseMediaDecodeTime": "baseMediaDecodeTime"},
    "trun": {"SampleCount": "sample_count", "DataOffset": "data_offset"},
    "mfro": {"container_size": "size"},
    "tfra": {"TrackId": "track_ID", "number_of_entries": "number_of_entry"}
  },
  "records": {"AVCDecoderConfigurationRecord": true},
  "entries": {
    "BrandEntry": {"array": "compatible_brands", "value": "AlternateBrand"},
    "EditListEntry": {"array": "entries", "fields": {"Duration": "segment_duration", "MediaTime": "media_time",
                                                    "MediaRate": "media_rate_integer"}},
    "TimeToSampleEntry": {"array": "entries", "fields": {"SampleCount": "sample_count", "SampleDelta": "sample_delta"}},
    "CompositionOffsetEntry": {"array": "entries", "fields": {"SampleCount": "sample_count",
                                                             "CompositionOffset": "sample_offset"}},
    "SyncSampleEntry": {"array": "entries", "fields": {"sampleNumber": "sample_number"}},
    "SampleToChunkEntry": {"array": "entries", "fields": {"FirstChunk": "first_chunk",
                                                         "SamplesPerChunk": "samples_per_chunk",
                                                         "SampleDescriptionIndex": "sample_description_index"}},
    "SampleSizeEntry": {"array": "entries", "fields": {"Size": "entry_size"}},
    "ChunkEntry": {"array": "entries", "fields": {"offset": "chunk_offset"}},
    "SequenceParameterSet": {"array": "sequenceParameterSetNALUnit", "value": "content", "conv": "blob"},
    "PictureParameterSet": {"array": "pictureParameterSetNALUnit", "value": "content", "conv": "blob"},
    "TrackRunEntry": {"array": "entries", "fields": {"Duration": "sample_duration", "Size": "sample_size",
                                                    "Flags": ["sample_flags", "hex"],
                                                    "CTSOffset": "sample_composition_time_offset"}},
    "RandomAccessEntry": {"array": "entries", "fields": {"time": "time", "moof_offset": "moof_offset",
                                                        "traf": "traf_number", "trun": "trun_number",
                                                        "sample": "sample_number"}}
  }
}
